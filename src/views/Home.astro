---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import TeamScan from '../components/TeamScan.astro';
import ScanStrip from '../components/ScanStrip.astro';
import { path, footnotes, type Lang } from '../i18n';
import { t } from '../i18n/ui';
import { site } from '../data/site';
import { runs, strengths, totalRaters } from '../data/reviews';
import { pick } from '../data/sources';
import photo from '../assets/images/jesse-whiteboard.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);

const copy = {
  nl: {
    title: 'AI-training voor teams | Jesco Trainingen',
    description: 'Praktische AI-training van een dagdeel voor je hele team: prompten met eigen werk, weten wanneer je AI kunt vertrouwen en samen afspraken maken. Vanaf €1.250 excl. btw.',
    h1a: 'Iedereen in je team gebruikt AI.',
    h1b: 'Ieder op zijn eigen manier.',
    lead: 'Een praktische AI-training voor je hele team. Prompten met eigen werk, weten wanneer je AI kunt vertrouwen, en samen afspraken maken. Met de psychologie van gedrag als basis, zodat het daarna ook echt gebruikt wordt.',
    specs: [
      ['duur', 'dagdeel, 2 à 3 uur'],
      ['groep', '8 tot 16 deelnemers'],
      ['waar', 'bij jullie op locatie'],
      ['taal', 'Nederlands of Engels'],
    ],
    priceLabel: 'vanaf',
    price: '€1.250 excl. btw per groep',
    note: '[1] Hoe zit dat bij jullie? De teamscan vertelt het je in een minuut.',
    darkH2: 'Een taalmodel weet niets. Het voorspelt.',
    darkP: 'Elk antwoord is een reeks gokken naar het meest waarschijnlijke volgende woord. Daarom klinkt AI altijd overtuigend, ook als het niet klopt. Wie dat snapt, weet wanneer je het kunt vertrouwen en wanneer je moet checken.',
    tokenSentence: 'Mijn team gebruikt AI',
    tokens: [['voor', 31], ['vooral', 18], ['nog', 12], ['niet', 9], ['stiekem', 4]],
    tokenCaption: 'Illustratie: zo kiest een taalmodel het volgende woord. De percentages zijn een voorbeeld.',
    diffBefore: 'zo vraagt je team het nu',
    diffAfter: 'na de training',
    promptBefore: 'Schrijf een mail naar een klant over de vertraging.',
    promptAfter: [
      ['Je bent projectleider bij een installatiebedrijf.', true],
      [' Schrijf een mail ', false],
      ['van maximaal 120 woorden', true],
      [' aan een vaste klant: ', false],
      ['de oplevering schuift twee weken door een late levering.', true],
      [' ', false],
      ['Toon: eerlijk en oplossingsgericht.', true],
      [' ', false],
      ['Sluit af met een voorstel om te bellen.', true],
    ],
    diffLegend: 'rol · context · grenzen · toon · vervolgstap',
    psyLabel: 'de psychologie',
    psyH2: 'Waarom de een AI blind vertrouwt en de ander het links laat liggen.',
    psyP1: 'Mensen haken sneller af op een fout van een algoritme dan op dezelfde fout van een mens.[2] Tegelijk nemen we antwoorden die er verzorgd uitzien makkelijk klakkeloos over.[3] En als een nieuwe tool vooral voelt als extra druk, groeit de weerstand.[4]',
    psyP2: 'In de training maken we die mechanismen zichtbaar. Niet als theorie, maar met jullie eigen voorbeelden: waar vertrouw je te veel, waar te weinig, en wat spreek je samen af?',
    notes: ['algoritme-aversie', 'automation bias', 'technostress'],
    dayH2: 'Eén dagdeel, drie delen.',
    dayNote: 'Vooraf een intake met jou. De kern staat vast, de rest stemmen we af op jullie doelen.',
    day: [
      ['0:00', 'Hoe AI denkt, en hoe wij denken', 'Wat een taalmodel wel en niet kan, en waarom we het te veel of te weinig vertrouwen.', 45],
      ['0:45', 'Prompten met eigen werk', 'Iedereen oefent met echte taken uit jullie praktijk. Daarna bespreken we in de groep wat werkt en wat niet.', 75],
      ['2:00', 'Afspraken en het gesprek', 'Wat mag wel en niet, wie checkt wat, en hoe houd je iedereen aan boord.', 60],
    ],
    complement: 'Al een Copilot- of ChatGPT-training gehad? Dan is dit de stap die ervoor zorgt dat het ook gebruikt wordt. Het is geen toolcursus: we werken met de tools die jullie al hebben.',
    toTraining: 'Alles over de training',
    revLabel: 'trainer card · jesse-venniker',
    revBy: 'deelnemer, masterclass met AI-deel, juni 2026',
    runLabel: (i: number, org: string, n: number) => `Trainer algemeen, run ${i} (${org}, ${n} deelnemers)`,
    nineUp: 'Run 1: deelnemers met een 9 of hoger',
    nineUpValue: '8 van 8',
    allReviews: `Bekijk de volledige trainer card (${totalRaters} evaluaties)`,
    photoAlt: 'Jesse geeft een training: hij staat voor een whiteboard en een scherm met een groep',
  },
  en: {
    title: 'AI training for teams | Jesco Trainingen',
    description: 'A hands-on, half-day AI training for your whole team: prompting with your own work, knowing when to trust AI, and agreeing on how you use it. From €1,250 excl. VAT.',
    h1a: 'Everyone on your team uses AI.',
    h1b: 'Each in their own way.',
    lead: 'Hands-on AI training for your whole team. Prompting with your own work, knowing when AI can be trusted, and agreeing on how you use it together. Built on the psychology of behaviour, so it actually sticks.',
    specs: [
      ['length', 'half a day, 2–3 hours'],
      ['group', '8 to 16 people'],
      ['where', 'at your office'],
      ['language', 'English or Dutch'],
    ],
    priceLabel: 'from',
    price: '€1,250 excl. VAT per group',
    note: '[1] So how does that look in your team? The team scan tells you in a minute.',
    darkH2: 'A language model doesn’t know anything. It predicts.',
    darkP: 'Every answer is a chain of guesses at the most likely next word. That’s why AI always sounds convincing, even when it’s wrong. Once you get that, you know when to trust it and when to check.',
    tokenSentence: 'My team uses AI',
    tokens: [['for', 31], ['mostly', 18], ['daily', 12], ['rarely', 9], ['secretly', 4]],
    tokenCaption: 'Illustration: how a language model picks the next word. The percentages are an example.',
    diffBefore: 'how your team asks today',
    diffAfter: 'after the training',
    promptBefore: 'Write an email to a client about the delay.',
    promptAfter: [
      ['You’re a project manager at an installation company.', true],
      [' Write an email ', false],
      ['of no more than 120 words', true],
      [' to a long-standing client: ', false],
      ['handover is two weeks late because a delivery came in late.', true],
      [' ', false],
      ['Tone: honest and solution-focused.', true],
      [' ', false],
      ['End by suggesting a quick call.', true],
    ],
    diffLegend: 'role · context · limits · tone · next step',
    psyLabel: 'the psychology',
    psyH2: 'Why some people trust AI blindly and others won’t touch it.',
    psyP1: 'People give up on an algorithm faster after seeing it make a mistake than on a person who makes the same one.[2] At the same time, we readily accept answers that look polished.[3] And when a new tool mostly feels like extra pressure, resistance grows.[4]',
    psyP2: 'In the session we make those patterns visible. Not as theory, but with your own examples: where do you trust it too much, where too little, and what do you agree on as a team?',
    notes: ['algorithm aversion', 'automation bias', 'technostress'],
    dayH2: 'One half-day, three parts.',
    dayNote: 'It starts with an intake call with you. The core is fixed; the rest is tailored to your goals.',
    day: [
      ['0:00', 'How AI thinks, and how we think', 'What a language model can and can’t do, and why we trust it too much or too little.', 45],
      ['0:45', 'Prompting with your own work', 'Everyone practises on real tasks from your day-to-day. Then we talk as a group about what works and what doesn’t.', 75],
      ['2:00', 'Agreements, and the conversation', 'What’s allowed and what isn’t, who checks what, and how you keep everyone on board.', 60],
    ],
    complement: 'Already done a Copilot or ChatGPT course? This is the step that makes sure people actually use it. It’s not a tool course: we work with whatever your team already has.',
    toTraining: 'All about the training',
    revLabel: 'trainer card · jesse-venniker',
    revBy: 'participant, masterclass including AI, June 2026 (translated from Dutch)',
    runLabel: (i: number, org: string, n: number) => `Trainer overall, run ${i} (${org}, ${n} participants)`,
    nineUp: 'Run 1: participants scoring 9 or higher',
    nineUpValue: '8 of 8',
    allReviews: `See the full trainer card (${totalRaters} evaluations)`,
    photoAlt: 'Jesse running a session, standing in front of a whiteboard and a screen with a group',
  },
}[lang];

const notes = pick('dietvorst2015', 'parasuraman2010', 'tarafdar2007');
const quote = strengths[5][lang];
const max = Math.max(...copy.tokens.map((x) => Number(x[1])));

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    url: site.url,
    name: site.name,
    inLanguage: ['nl-NL', 'en'],
    publisher: { '@id': `${site.url}/#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: lang === 'nl' ? 'AI in je werk: AI-training voor teams' : 'AI at work: AI training for teams',
    serviceType: lang === 'nl' ? 'Incompany AI-training' : 'In-house AI training',
    description: copy.description,
    provider: { '@id': `${site.url}/#organization` },
    areaServed: { '@type': 'Country', name: 'NL' },
    availableLanguage: ['nl', 'en'],
    offers: {
      '@type': 'Offer',
      priceSpecification: { '@type': 'PriceSpecification', minPrice: site.priceFrom, priceCurrency: site.currency, valueAddedTaxIncluded: false },
    },
  },
];
---
<Base lang={lang} title={copy.title} description={copy.description} schema={schema}>
  <section class="hero wrap">
    <h1>{copy.h1a} <span class="accent-text">{copy.h1b}</span><sup class="fn hero__fn"><a href="#teamscan">[1]</a></sup></h1>
    <div class="hero__row">
      <div class="hero__text stack" style="--gap: 28px">
        <p class="lead">{copy.lead}</p>
        <dl class="specs">
          {copy.specs.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
          <div><dt>{copy.priceLabel}</dt><dd><strong>{copy.price}</strong></dd></div>
        </dl>
        <div class="row" style="--gap: 10px">
          <a class="btn btn--primary" href="#teamscan">{s.cta.scan}</a>
          <a class="btn btn--line" href={path('training', lang)}>{s.cta.training}</a>
        </div>
        <p class="label">{copy.note}</p>
      </div>
      <div class="laptop">
        <div class="laptop__screen">
          <TeamScan lang={lang} />
        </div>
        <div class="laptop__base" aria-hidden="true"><span></span></div>
      </div>
    </div>
  </section>

  <section class="dark predict">
    <div class="wrap stack" style="--gap: 72px">
      <div class="row predict__row">
        <div class="stack predict__text" style="--gap: 18px">
          <h2>{copy.darkH2}</h2>
          <p class="lead">{copy.darkP}</p>
        </div>
        <figure class="tokens">
          <p class="tokens__sentence">{copy.tokenSentence} <span class="tokens__blank" aria-hidden="true"></span></p>
          <ul class="tokens__list">
            {copy.tokens.map(([word, pct], i) => (
              <li>
                <span class="tokens__word">{word}</span>
                <span class="tokens__bar" style={`width: ${(Number(pct) / max) * 62}%; opacity: ${1 - i * 0.15}`}></span>
                <span class="tokens__pct">{pct}%</span>
              </li>
            ))}
          </ul>
          <figcaption class="label">{copy.tokenCaption}</figcaption>
        </figure>
      </div>

      <div class="diff">
        <div class="diff__row">
          <span class="label">− {copy.diffBefore}</span>
          <p class="diff__before">{copy.promptBefore}</p>
        </div>
        <div class="diff__row">
          <span class="label diff__plus">+ {copy.diffAfter}</span>
          <div class="stack" style="--gap: 12px">
            <p class="diff__after">{copy.promptAfter.map(([text, marked]) => marked ? <mark>{text}</mark> : text)}</p>
            <span class="label">{copy.diffLegend}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap section psy">
    <div class="psy__body stack" style="--gap: 26px">
      <span class="label accent-text">{copy.psyLabel}</span>
      <h2>{copy.psyH2}</h2>
      <p class="lead" set:html={footnotes(copy.psyP1)} />
      <p class="lead">{copy.psyP2}</p>
      <a class="textlink" href={path('research', lang)}>{s.readResearch}</a>
    </div>
    <aside class="margin-notes psy__notes" aria-label={s.sources}>
      <ol>
        {notes.map((n, i) => (
          <li id={`bron-${i + 2}`}>
            <span class="label">[{i + 2}] {copy.notes[i]}</span>
            <cite><a href={n.url} rel="noopener">{n.short}</a></cite>
          </li>
        ))}
      </ol>
    </aside>
  </section>

  <section class="wrap day">
    <div class="day__head">
      <h2 class="day__h2">{copy.dayH2}</h2>
      <p class="muted">{copy.dayNote}</p>
    </div>
    <div class="timeline">
      {copy.day.map(([time, title, text, weight]) => (
        <div style={`flex: ${weight} 1 260px`}>
          <span class="label">{time}</span>
          <h3>{title}</h3>
          <p>{text}</p>
        </div>
      ))}
    </div>
    <div class="complement">
      <p>{copy.complement}</p>
      <a class="textlink" href={path('training', lang)}>{copy.toTraining}</a>
    </div>
  </section>

  <section class="reviews">
    <div class="wrap section reviews__grid">
      <Image src={photo} alt={copy.photoAlt} widths={[400, 680, 900]} sizes="(max-width: 760px) 100vw, 360px" class="reviews__photo" />
      <div class="stack reviews__body" style="--gap: 32px">
        <span class="label">{copy.revLabel}</span>
        <figure class="stack" style="--gap: 14px; margin: 0">
          <blockquote class="quote-xl">“{quote}”</blockquote>
          <figcaption class="label">{copy.revBy}</figcaption>
        </figure>
        <div class="report">
          {runs.map((r, i) => (
            <div><span>{copy.runLabel(i + 1, r.org, r.n)}</span><span class="dots" aria-hidden="true"></span><strong>{r.scores.overall.toLocaleString(lang === 'nl' ? 'nl-NL' : 'en-GB')}</strong></div>
          ))}
          <div><span>{copy.nineUp}</span><span class="dots" aria-hidden="true"></span><strong>{copy.nineUpValue}</strong></div>
        </div>
        <a href={path('experiences', lang)} class="textlink">{copy.allReviews}</a>
      </div>
    </div>
  </section>

  <ScanStrip lang={lang} />
</Base>

<style>
  .hero { padding-top: clamp(48px, 8vw, 80px); position: relative; z-index: 2; }
  .hero h1 { max-width: 12.5em; }
  .hero__fn { font-size: 0.2em; vertical-align: top; position: relative; top: 0.5em; }
  .hero__row { display: flex; flex-wrap: wrap; gap: 48px 56px; padding-top: clamp(36px, 5vw, 56px); align-items: flex-start; }
  .hero__text { flex: 1 1 320px; min-width: 0; max-width: 430px; }
  .hero__text .lead { font-size: 1.15rem; }

  .laptop { flex: 1.6 1 520px; min-width: 0; margin-bottom: -220px; display: flex; flex-direction: column; align-items: center; }
  .laptop__screen { width: 100%; height: 580px; padding: 12px 12px 16px; border-radius: 20px 20px 6px 6px; background: #1a1d1b; box-shadow: 0 40px 80px -30px rgba(10, 25, 18, 0.55); }
  .laptop__base { width: 106%; height: 15px; border-radius: 0 0 16px 16px; background: #c9c6be; display: flex; justify-content: center; }
  .laptop__base span { width: 86px; height: 5px; border-radius: 0 0 7px 7px; background: #b3b0a8; }
  @media (max-width: 760px) {
    .laptop { margin-bottom: -140px; }
    .laptop__screen { height: 540px; padding: 8px 8px 12px; border-radius: 14px 14px 6px 6px; }
    .laptop__base { width: 104%; }
  }

  .predict > .wrap { padding-top: 300px; padding-bottom: var(--section); }
  @media (max-width: 760px) { .predict > .wrap { padding-top: 210px; } }
  .predict__row { --gap: 32px 56px; align-items: flex-start; }
  .predict__text { flex: 1 1 340px; min-width: 0; max-width: 470px; }
  .tokens { flex: 1.4 1 440px; min-width: 0; margin: 0; display: flex; flex-direction: column; gap: 18px; font-family: var(--mono); }
  .tokens__sentence { font-size: clamp(1.25rem, 2.2vw, 1.75rem); line-height: 1.3; }
  .tokens__blank { display: inline-block; width: 3.5em; border-bottom: 2px solid var(--lime); transform: translateY(-0.1em); }
  .tokens__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .tokens__list li { display: flex; align-items: center; gap: 14px; font-size: 0.95rem; }
  .tokens__word { width: 84px; flex-shrink: 0; }
  .tokens__bar { height: 8px; background: var(--lime); border-radius: 1px; }
  .tokens__pct { color: var(--on-dark-2); }

  .diff { border-top: 1px solid var(--dark-rule); }
  .diff__row { display: flex; flex-wrap: wrap; gap: 8px 32px; padding: 22px 0; border-bottom: 1px solid var(--dark-rule); align-items: baseline; }
  .diff__row > .label { flex: 0 0 180px; }
  .diff__row > p, .diff__row > .stack { flex: 1 1 460px; min-width: 0; }
  .diff__plus { color: var(--lime) !important; }
  .diff__before, .diff__after { font-family: var(--mono); font-size: 1rem; line-height: 1.8; }
  .diff__before { color: var(--on-dark-3); text-decoration: line-through; text-decoration-color: #6e8a78; }
  .diff__after mark { background: none; color: inherit; border-bottom: 2px solid var(--lime); }

  .psy { display: flex; flex-wrap: wrap; gap: 40px 64px; align-items: flex-start; }
  .psy__body { flex: 2 1 540px; min-width: 0; max-width: 720px; }
  .psy__notes { flex: 1 1 260px; min-width: 0; max-width: 340px; padding-top: 44px; }

  .day { padding-bottom: var(--section); display: flex; flex-direction: column; gap: 36px; }
  .day__head { display: flex; flex-wrap: wrap; gap: 12px 40px; align-items: baseline; justify-content: space-between; }
  .day__h2 { font-size: clamp(1.9rem, 3.4vw, 2.9rem); }
  .day__head .muted { max-width: 30rem; }
  .complement { display: flex; flex-wrap: wrap; gap: 12px 40px; align-items: baseline; justify-content: space-between; padding-top: 28px; border-top: 1px solid var(--rule); }
  .complement p { max-width: 44rem; font-size: 1.15rem; line-height: 1.55; }

  .reviews { border-top: 1px solid var(--rule); }
  .reviews__grid { display: flex; flex-wrap: wrap; gap: 48px 72px; align-items: flex-start; }
  .reviews__photo { flex: 0 1 340px; min-width: 0; width: 100%; height: 520px; object-fit: cover; object-position: center 30%; border-radius: 4px; }
  .reviews__body { flex: 1 1 460px; min-width: 0; }
  @media (max-width: 760px) { .reviews__photo { height: 380px; flex-basis: 100%; } }
</style>

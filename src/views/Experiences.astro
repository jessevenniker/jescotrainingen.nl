---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ScanStrip from '../components/ScanStrip.astro';
import { path, type Lang } from '../i18n';
import { site } from '../data/site';
import { metrics, runs, totalRaters, average, traits } from '../data/reviews';

interface Props { lang: Lang }
const { lang } = Astro.props;
const locale = lang === 'nl' ? 'nl-NL' : 'en-GB';
const num = (n: number) => n.toLocaleString(locale, { minimumFractionDigits: 1, maximumFractionDigits: 1 });

const copy = {
  nl: {
    title: 'Ervaringen: de trainer card van Jesse Venniker | Jesco Trainingen',
    description: `Deelnemers geven Jesse Venniker als trainer gemiddeld een ${num(average)}. Bekijk de trainer card met de scores van ${totalRaters} deelnemers.`,
    label: 'ervaringen',
    h1: 'Wat deelnemers zeggen.',
    lead: `AI-modellen hebben een model card. Deze trainer ook. Met scores en sterke punten, gebaseerd op ${totalRaters} evaluaties.`,
    file: 'trainer-card.md',
    meta: [
      ['model', 'Jesse Venniker'],
      ['type', 'trainer, AI en gedrag'],
      ['talen', 'nl, en'],
      ['trainingsdata', `toegepaste psychologie · 2 masterclasses · ${totalRaters} evaluaties`],
      ['beoogd gebruik', 'teams van 8 tot 16 mensen die AI samen beter willen inzetten'],
      ['niet bedoeld voor', 'een knoppencursus Excel'],
    ],
    benchH: 'benchmarks',
    benchNote: 'Schaal 1 tot 10. Beide runs waren masterclasses Effectief vergaderen, met een AI-deel.',
    run: 'run',
    traitsH: 'meest genoemd',
    traitsNote: `run 2 · ${traits.n} deelnemers · meerdere antwoorden mogelijk`,
  },
  en: {
    title: 'Reviews: Jesse Venniker’s trainer card | Jesco Trainingen',
    description: `Participants rate Jesse Venniker ${num(average)} out of 10 as a trainer on average. See the trainer card with scores from ${totalRaters} participants.`,
    label: 'reviews',
    h1: 'What participants say.',
    lead: `AI models come with a model card. So does this trainer. Scores and strengths, based on ${totalRaters} evaluations.`,
    file: 'trainer-card.md',
    meta: [
      ['model', 'Jesse Venniker'],
      ['type', 'trainer, AI and behaviour'],
      ['languages', 'en, nl'],
      ['training data', `applied psychology · 2 masterclasses · ${totalRaters} evaluations`],
      ['intended use', 'teams of 8 to 16 people who want to use AI better, together'],
      ['not intended for', 'a click-by-click Excel course'],
    ],
    benchH: 'benchmarks',
    benchNote: 'Scale of 1 to 10. Both runs were masterclasses on effective meetings, including AI.',
    run: 'run',
    traitsH: 'most mentioned',
    traitsNote: `run 2 · ${traits.n} participants · multiple answers allowed`,
  },
}[lang];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: site.name, item: new URL(path('home', lang), site.url).href },
      { '@type': 'ListItem', position: 2, name: copy.h1, item: new URL(path('experiences', lang), site.url).href },
    ],
  },
];
---
<Base lang={lang} title={copy.title} description={copy.description} schema={schema}>
  <PageHead label={copy.label} title={copy.h1} lead={copy.lead} />

  <section class="night card-wrap">
    <div class="wrap section">
      <article class="card" aria-label={copy.file}>
        <div class="card__bar">
          <span class="card__dot" aria-hidden="true"></span>
          <span>{copy.file}</span>
          <span class="card__ver">jesse-venniker</span>
        </div>

        <div class="card__body">
          <dl class="card__meta">
            {copy.meta.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
          </dl>

          <div class="card__main">
            <section class="block" aria-labelledby="bench">
              <h2 class="block__h" id="bench"><span aria-hidden="true">## </span>{copy.benchH}</h2>
              <div class="bench" role="table">
                <div class="bench__row bench__head" role="row">
                  <span role="columnheader"></span>
                  {runs.map((r, i) => (
                    <span role="columnheader">{copy.run} {i + 1}<small>{r.org} · n = {r.n}</small></span>
                  ))}
                </div>
                {metrics.map((m) => (
                  <div class="bench__row" role="row">
                    <span role="rowheader">{m.label[lang]}</span>
                    {runs.map((r) => (
                      <span role="cell" class="bench__cell">
                        <strong>{num(r.scores[m.id])}</strong>
                        <span class="bench__track" aria-hidden="true"><span style={`width: ${r.scores[m.id] * 10}%`}></span></span>
                      </span>
                    ))}
                  </div>
                ))}
              </div>
              <p class="block__note">{copy.benchNote} {runs[0].note && <>{copy.run === 'run' ? 'Run' : copy.run} 1: {runs[0].note[lang]}.</>}</p>
            </section>

            <section class="block" aria-labelledby="traits">
              <h2 class="block__h" id="traits"><span aria-hidden="true">## </span>{copy.traitsH}</h2>
              <ul class="weights">
                {traits.items.map((tr) => (
                  <li>
                    <span class="weights__label">{tr.label[lang]}</span>
                    <span class="weights__track" aria-hidden="true"><span style={`width: ${(tr.count / traits.n) * 100}%`}></span></span>
                    <span class="weights__n">{tr.count}/{traits.n}</span>
                  </li>
                ))}
              </ul>
              <p class="block__note">{copy.traitsNote}</p>
            </section>

          </div>
        </div>
      </article>
    </div>
  </section>

  <ScanStrip lang={lang} />
</Base>

<style>
  /* Trainer card */
  .card { border: 1px solid #2c4c39; border-radius: 10px; overflow: hidden; background: var(--night); }
  .card__bar { display: flex; align-items: center; gap: 10px; padding: 12px 18px; background: var(--night-2); border-bottom: 1px solid #24402f; font-family: var(--mono); font-size: 0.8125rem; color: var(--on-dark-2); }
  .card__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--lime); }
  .card__ver { margin-left: auto; color: var(--on-dark-3); }
  .card__body { display: flex; flex-wrap: wrap; }
  .card__meta { flex: 1 1 300px; min-width: 0; margin: 0; padding: 28px; border-right: 1px solid #24402f; display: flex; flex-direction: column; gap: 18px; }
  .card__meta div { display: flex; flex-direction: column; gap: 4px; }
  .card__meta dt { font-family: var(--mono); font-size: 0.75rem; color: var(--lime); }
  .card__meta dd { margin: 0; font-size: 0.98rem; line-height: 1.45; color: var(--on-dark); }
  .card__main { flex: 2.4 1 520px; min-width: 0; padding: 28px clamp(20px, 3vw, 40px); display: flex; flex-direction: column; gap: 40px; }
  @media (max-width: 860px) { .card__meta { border-right: 0; border-bottom: 1px solid #24402f; } }

  .block { display: flex; flex-direction: column; gap: 16px; }
  .block__h { font-family: var(--mono); font-size: 0.9rem; font-weight: 500; letter-spacing: 0; color: var(--on-dark); }
  .block__h span { color: var(--lime); }
  .block__note { font-family: var(--mono); font-size: 0.75rem; line-height: 1.6; color: var(--on-dark-3); }

  .bench { display: flex; flex-direction: column; border-top: 1px solid #2c4c39; }
  .bench__row { display: grid; grid-template-columns: minmax(0, 1.4fr) repeat(2, minmax(0, 1fr)); gap: 12px 24px; align-items: center; padding: 14px 0; border-bottom: 1px solid #24402f; }
  .bench__head { font-family: var(--mono); font-size: 0.8125rem; color: var(--on-dark-2); }
  .bench__head small { display: block; font-size: 0.6875rem; color: var(--on-dark-3); margin-top: 2px; }
  .bench__row > span:first-child { color: var(--on-dark); font-size: 0.95rem; line-height: 1.35; }
  .bench__cell { display: flex; flex-direction: column; gap: 6px; }
  .bench__cell strong { font-family: var(--mono); font-weight: 500; font-size: 1.35rem; color: var(--on-dark); }
  .bench__track { height: 4px; background: #24402f; border-radius: 2px; overflow: hidden; }
  .bench__track span { display: block; height: 100%; background: var(--lime); }
  @media (max-width: 560px) {
    .bench__row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .bench__row > span:first-child { grid-column: 1 / -1; }
    .bench__head > span:first-child { display: none; }
  }

  .weights { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .weights li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 6px 16px; align-items: center; }
  .weights__label { color: var(--on-dark); font-size: 0.95rem; }
  .weights__track { grid-column: 1; height: 8px; background: #24402f; border-radius: 1px; overflow: hidden; }
  .weights__track span { display: block; height: 100%; background: var(--lime); }
  .weights__n { grid-column: 2; grid-row: 1 / 3; font-family: var(--mono); font-size: 0.95rem; color: var(--lime); }

</style>

---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ScanStrip from '../components/ScanStrip.astro';
import SlideLaptop from '../components/SlideLaptop.astro';
import TrustMeter from '../components/TrustMeter.astro';
import { path, type Lang } from '../i18n';
import { t } from '../i18n/ui';
import { site } from '../data/site';
import { runs, totalRaters, average } from '../data/reviews';
import '../styles/training.css';
import { Image } from 'astro:assets';
import whiteboardFoto from '../assets/images/training-whiteboard.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const num = (n: number) => n.toLocaleString(lang === 'nl' ? 'nl-NL' : 'en-GB');
const kb = (slug: { nl: string; en: string }) => (lang === 'nl' ? `/kennisbank/${slug.nl}/` : `/en/insights/${slug.en}/`);
const trustArticle = kb({ nl: 'waarom-je-team-ai-te-veel-of-te-weinig-vertrouwt', en: 'why-your-team-trusts-ai-too-much-or-too-little' });
const thinkArticle = kb({ nl: 'denk-je-nog-zelf-als-ai-meedenkt', en: 'are-you-still-thinking-when-ai-thinks-along' });

const copy = {
  nl: {
    title: 'AI-training voor teams, vanuit de psychologie | Jesco Trainingen',
    description: 'Incompany AI-training van een dagdeel voor teams, gebouwd op de psychologie van gedrag. Oefenen met eigen werk, AI terecht vertrouwen en werken aan AI-geletterdheid. Vanaf €1.250 excl. btw.',
    label: 'de training',
    h1: 'AI in je werk',
    lead: 'Een AI-training van een dagdeel, gebouwd op de psychologie van gedrag. Je team leert waarom AI zo overtuigend klinkt, wanneer je het kunt vertrouwen en hoe het in je eigen werk past. Zodat AI geen hobby van een paar mensen blijft.',
    proof: [`${runs.length} trainingen`, `${totalRaters} deelnemers`, `gemiddeld een ${num(average)}`],
    proofLink: 'Bekijk de ervaringen',
    video: {
      src: '/video/ai-workshop.mp4',
      poster: '/video/ai-workshop-poster.jpg',
      caption: 'het dagdeel in 39 seconden · zonder geluid',
      description: 'Video van 39 seconden zonder geluid. AI geeft een zelfverzekerd antwoord met een verzonnen bron: klinkt overtuigend, klopt niet altijd. Daarna kiest een taalmodel het meest waarschijnlijke woord, naast een meter die loopt van te weinig naar te veel vertrouwen. Dan een goede vraag aan AI in vijf delen: rol, context, grenzen, toon en vervolgstap, met het antwoord zonder en met die opbouw. Tot slot sluiten collega’s één voor één aan: geen hobby van een paar mensen.',
    },
    forH2: 'Voor wie',
    forP: [
      'Voor organisaties met zo’n 10 tot 50 kantoormedewerkers, waar AI al gebruikt wordt of juist nog niet echt van de grond komt.',
      'De groep bestaat uit 8 tot 16 deelnemers. Dat mag een heel team zijn, of een mix van afdelingen. Ervaring met AI is niet nodig: juist een gemengde groep leert veel van elkaar.',
    ],
    rolesH2: 'Met jullie eigen werk',
    rolesP: 'Geen verzonnen casussen. Iedereen oefent met een taak die morgen weer op zijn bureau ligt. Een paar voorbeelden van wat we in de training doen:',
    roles: [
      ['HR', 'Een vacaturetekst die klinkt als jullie organisatie, en niet als iedere andere.', 'Waar het misgaat: AI maakt elke tekst even glad. Je leert sturen op toon en checken op aannames over de kandidaat.'],
      ['Communicatie', 'Een eerste versie van een nieuwsbericht of LinkedIn-post, plus vijf koppen om uit te kiezen.', 'Waar het misgaat: ideeën van AI lijken op elkaar. Je leert AI gebruiken om breder te denken, niet om sneller hetzelfde te maken.'],
      ['Beleid', 'Een lang stuk samenvatten of in gewone taal zetten voor bewoners, klanten of collega’s.', 'Waar het misgaat: een samenvatting klinkt zeker, ook waar het origineel twijfelt. Je leert wat je altijd naast de bron legt.'],
      ['Klantenservice', 'Een antwoord op een lastige klacht: vriendelijk, duidelijk en binnen jullie afspraken.', 'Waar het misgaat: AI belooft makkelijk iets wat jullie niet waarmaken. Je leert grenzen meegeven in je vraag.'],
    ],
    howH2: 'Hoe het werkt',
    photoAlt: 'Een deelnemer schrijft op het whiteboard terwijl Jesse meekijkt. Op het scherm: een behandelingsplan per agendapunt.',
    photoCaption: 'Uit de masterclass vergaderen: deelnemers werken zelf, met hun eigen agenda als oefenmateriaal.',
    steps: [
      ['01', 'Intake', 'Een gesprek met jou van ongeveer drie kwartier. Wat speelt er in je team, waar wil je naartoe, welke tools gebruiken jullie? De kern van de training staat vast, de rest stemmen we hierop af.'],
      ['02', 'Het dagdeel', 'Twee à drie uur bij jullie op locatie, in drie delen: hoe AI denkt en hoe wij denken, prompten met eigen werk, en afspraken en het gesprek. Met slides en werkbladen in jullie huisstijl.'],
      ['03', 'Na vier weken', 'Een korte meting bij de deelnemers: gebruiken ze AI, en hoe zeker voelen ze zich? Zo zie je wat de training heeft opgeleverd.'],
    ],
    dayH2: 'Wat er in het dagdeel gebeurt',
    day: [
      ['0:00', 'Hoe AI denkt, en hoe wij denken', ['Wat een taalmodel wel en niet kan', 'Waarom AI altijd overtuigend klinkt, ook als het niet klopt', 'Waarom AI je zo makkelijk gelijk geeft', 'Waarom de een te veel vertrouwt en de ander te weinig', 'Wat één vraag kost aan stroom en water, en waarom dat optelt'], 45],
      ['0:45', 'Prompten met eigen werk', ['Een vaste opbouw voor goede vragen: rol, context, grenzen, toon, vervolgstap', 'Oefenen met echte taken uit jullie praktijk', 'Eerst zelf denken, dan AI: zo blijft het je eigen werk', 'Groepsgesprek: wat werkt, wat niet, en waarom'], 75],
      ['2:00', 'Afspraken en het gesprek', ['Wat mag wel en niet in AI-tools, en wie checkt wat', 'Werkdruk en brain fry: minder tools, vaste momenten om AI-werk na te lopen en een eindtijd', 'Wanneer je AI bewust níet gebruikt', 'Hoe je collega’s meeneemt die twijfelen of weerstand voelen', 'Een eerste versie van jullie eigen AI-afspraken'], 60],
    ],
    termsH2: 'De psychologie erachter',
    termsP: 'De meeste AI-trainingen gaan over wat de tool kan. Deze gaat ook over wat er in je hoofd gebeurt als je ermee werkt. Vier begrippen die in de training terugkomen:',
    terms: [
      ['Automation bias', 'De neiging om een antwoord van een systeem over te nemen, ook als je eigen kennis iets anders zegt. Hoe overtuigender AI klinkt, hoe sterker dit werkt.', trustArticle, 'Lees meer over vertrouwen in AI'],
      ['Algoritme-aversie', 'Het omgekeerde: na één fout van AI haak je af, terwijl je een collega die dezelfde fout maakt gewoon een tweede kans geeft.', trustArticle, 'Lees meer over vertrouwen in AI'],
      ['Cognitive offloading', 'Denkwerk uitbesteden aan een hulpmiddel. Vaak slim, maar wie te vroeg en te veel uitbesteedt, denkt minder kritisch na.', thinkArticle, 'Lees meer over zelf blijven denken'],
      ['Motiverende gespreksvoering', 'Een gespreksmethode uit de psychologie om mensen te helpen die twijfelen. In de training gebruik ik die om collega’s mee te nemen die weerstand voelen, zonder te duwen.', path('trainer', 'nl'), 'Over de achtergrond van de trainer'],
    ],
    literacyH2: 'Werken aan AI-geletterdheid',
    literacyP: [
      'Sinds februari 2025 vraagt de Europese AI-verordening (artikel 4 van de AI Act) organisaties die AI gebruiken om werk te maken van AI-geletterdheid bij hun medewerkers. De wet schrijft geen vaste cursus voor. Wel moet je kunnen laten zien wat je eraan doet.',
      'Deze training helpt je daarbij. Je team leert hoe AI werkt, waar de risico’s zitten en welke afspraken jullie maken. Daarnaast krijg je:',
    ],
    literacyItems: [
      'een deelnamebewijs voor iedere deelnemer;',
      'een verslag van één pagina met de leerdoelen, de aanwezigen en de afspraken die jullie hebben gemaakt, voor jullie AI-dossier.',
    ],
    literacyNote: 'Dit is geen juridisch advies. Wat jullie organisatie verder nodig heeft, hangt af van welke AI-systemen je gebruikt en waarvoor.',
    afterH2: 'Wat je team daarna anders doet',
    after: [
      'Ze stellen betere vragen aan AI en hoeven minder te herschrijven.',
      'Ze weten wanneer ze een antwoord kunnen gebruiken en wanneer ze moeten checken.',
      'Ze werken volgens dezelfde afspraken, in plaats van ieder op een eigen manier.',
      'Ze praten erover: wat werkt, wat niet, en wie kan wie helpen.',
    ],
    notToolH2: 'Geen toolcursus',
    notToolP: 'Er zijn goede cursussen die je stap voor stap leren werken met Copilot in Word en Excel. Dit is iets anders. Hier gaat het om hoe mensen met AI omgaan: vertrouwen, gewoontes en samenwerking. Al een toolcursus gehad? Dan is dit de stap die ervoor zorgt dat het ook gebruikt wordt. We werken met de tools die jullie al hebben, of dat nu ChatGPT, Copilot, Gemini of iets anders is.',
    practicalH2: 'Praktisch',
    specs: [
      ['duur', 'dagdeel, 2 à 3 uur'],
      ['groep', '8 tot 16 deelnemers'],
      ['waar', 'bij jullie op locatie'],
      ['taal', 'Nederlands of Engels'],
      ['materiaal', 'slides en werkbladen in jullie huisstijl'],
      ['inclusief', 'intake, meting na vier weken, deelnamebewijs en verslag'],
    ],
    priceLabel: 'vanaf',
    price: '€1.250 excl. btw per groep',
    crossLabel: 'ook beschikbaar',
    crossH: 'Masterclass Effectief vergaderen',
    crossP: 'De psychologie van vergaderen, een agenda-oefening en AI voor notulen en actiepunten. Los te boeken of samen met deze training.',
    crossCta: 'Bekijk de masterclass',
    faqH2: 'Veelgestelde vragen',
    faq: [
      ['Moeten deelnemers al met AI werken?', 'Nee. De training werkt voor beginners en voor mensen die AI al dagelijks gebruiken. In een gemengde groep leren mensen juist veel van elkaar.'],
      ['Wat bedoel je met “vanuit de psychologie”?', 'Dat de training niet alleen gaat over wat AI kan, maar over wat mensen ermee doen. Waarom vertrouwt de een te veel en de ander te weinig? Waarom voelt werken met AI sneller dan het soms is? En hoe neem je collega’s mee die twijfelen? Daar komt mijn achtergrond in de toegepaste psychologie vandaan.'],
      ['Helpt de training bij AI-geletterdheid uit de AI Act?', 'Ja. De AI Act vraagt organisaties werk te maken van AI-geletterdheid, maar schrijft geen vaste cursus voor. De training is een concrete stap: iedere deelnemer krijgt een deelnamebewijs en je krijgt een kort verslag voor jullie AI-dossier. Of dat voor jullie organisatie genoeg is, hangt af van welke AI je gebruikt en waarvoor.'],
      ['Met welke AI-tool werken we?', 'Met wat jullie al gebruiken: ChatGPT, Copilot, Gemini of iets anders. De aanpak werkt in elke tool. Heeft jullie organisatie nog niets, dan bespreken we in de intake waar je mee kunt beginnen.'],
      ['Is het materiaal in onze eigen huisstijl?', 'Ja. De slides en eventuele werkbladen krijgen jullie kleuren en jullie logo. Dat zit bij de prijs in. Zo past het materiaal na de training gewoon tussen jullie eigen documenten.'],
      ['Gaat de training ook over werkdruk en het milieu?', 'Ja. AI kan werkdruk verhogen, bijvoorbeeld door het vele nakijken, en elke vraag kost stroom en water. We bespreken wat onderzoek daarover zegt en nemen het mee in jullie afspraken: minder tools, vaste momenten om AI-werk na te lopen, en bewust kiezen wanneer je AI níet gebruikt.'],
      ['Is dit een Copilot- of ChatGPT-cursus?', 'Nee. Het is geen uitleg van knoppen en menu’s, maar een training in hoe je team AI goed en verantwoord inzet. Het past goed na een toolcursus.'],
      ['Wat kost het?', 'De training kost vanaf €1.250 excl. btw per groep, inclusief intake, de meting na vier weken, deelnamebewijzen en het verslag. De precieze prijs hoor je na de intake.'],
      ['Kunnen we dit combineren met de masterclass vergaderen?', 'Ja. Beide trainingen zijn samen te boeken, bijvoorbeeld op één dag of met een paar weken ertussen. In de intake kijken we wat het beste past.'],
      ['Waar vindt de training plaats?', 'Bij jullie op locatie. Een ruimte met een scherm is genoeg. Deelnemers nemen hun eigen laptop mee.'],
      ['Kan de training in het Engels?', 'Ja. De training kan volledig in het Engels, bijvoorbeeld voor internationale teams.'],
      ['Wat gebeurt er met onze bedrijfsgegevens?', 'Tijdens de training oefenen we zonder vertrouwelijke gegevens. Wat wel en niet in AI-tools mag, is juist een van de onderwerpen waar jullie samen afspraken over maken.'],
      ['Hoe snel kan de training plaatsvinden?', 'Na je bericht hoor je binnen vijf werkdagen van me. Dan plannen we de intake en zoeken we samen een datum die past.'],
    ],
  },
  en: {
    title: 'AI training for teams, grounded in psychology | Jesco Trainingen',
    description: 'A half-day, in-house AI training for teams, built on the psychology of behaviour. Practise on your own work, trust AI where it makes sense and build AI literacy. From €1,250 excl. VAT.',
    label: 'the training',
    h1: 'AI at work',
    lead: 'A half-day AI training built on the psychology of behaviour. Your team learns why AI sounds so convincing, when it can be trusted and how it fits into their own work. So AI stops being a side project for a few enthusiasts.',
    proof: [`${runs.length} sessions`, `${totalRaters} participants`, `average score ${num(average)}`],
    proofLink: 'See the reviews',
    video: {
      src: '/video/ai-workshop-en.mp4',
      poster: '/video/ai-workshop-en-poster.jpg',
      caption: 'the session in 39 seconds · no sound',
      description: 'A 39-second video without sound. AI gives a confident answer with a made-up source: sounds convincing, isn’t always right. Next, a language model picks the most likely word, next to a meter running from too little to too much trust. Then a good prompt in five parts: role, context, limits, tone and next step, with the answer without and with that structure. Finally, colleagues join one by one: not a side project for a few enthusiasts.',
    },
    forH2: 'Who it’s for',
    forP: [
      'Organisations with roughly 10 to 50 office staff, where AI is already in use or hasn’t quite taken off yet.',
      'Groups are 8 to 16 people: a whole team or a mix of departments. No AI experience needed. A mixed group actually learns a lot from each other.',
    ],
    rolesH2: 'With your own work',
    rolesP: 'No made-up case studies. Everyone practises on a task that will be back on their desk tomorrow. A few examples of what we do in the session:',
    roles: [
      ['HR', 'A job ad that sounds like your organisation, not like every other one.', 'Where it goes wrong: AI makes every text equally smooth. You learn to steer the tone and check for assumptions about the candidate.'],
      ['Communications', 'A first draft of a news item or LinkedIn post, plus five headlines to choose from.', 'Where it goes wrong: AI ideas tend to look alike. You learn to use AI to think wider, not to make the same thing faster.'],
      ['Policy', 'Summarising a long document, or rewriting it in plain language for residents, customers or colleagues.', 'Where it goes wrong: a summary sounds certain, even where the original has doubts. You learn what to always check against the source.'],
      ['Customer service', 'A reply to a tricky complaint: friendly, clear and within your own policies.', 'Where it goes wrong: AI easily promises things you can’t deliver. You learn to build limits into your prompt.'],
    ],
    howH2: 'How it works',
    photoAlt: 'A participant writes on the whiteboard while Jesse looks on. On the screen: a plan for each agenda item.',
    photoCaption: 'From the meetings masterclass: participants do the work themselves, using their own agenda as practice material.',
    steps: [
      ['01', 'Intake', 'A conversation with you of about 45 minutes. What’s going on in your team, where do you want to get to, which tools do you use? The core of the training is fixed; the rest is shaped around this.'],
      ['02', 'The session', 'Two to three hours at your office, in three parts: how AI thinks and how we think, prompting with your own work, and agreements and the conversation. With slides and worksheets in your house style.'],
      ['03', 'Four weeks later', 'A short check-in survey for participants: are they using AI, and how confident do they feel? That way you see what the training actually changed.'],
    ],
    dayH2: 'What happens in the session',
    day: [
      ['0:00', 'How AI thinks, and how we think', ['What a language model can and can’t do', 'Why AI always sounds convincing, even when it’s wrong', 'Why AI agrees with you so easily', 'Why some people trust it too much and others too little', 'What a single prompt costs in electricity and water, and why it adds up'], 45],
      ['0:45', 'Prompting with your own work', ['A simple structure for good prompts: role, context, limits, tone, next step', 'Practising on real tasks from your day-to-day', 'Think first, then use AI: that’s how it stays your own work', 'Group discussion: what works, what doesn’t, and why'], 75],
      ['2:00', 'Agreements, and the conversation', ['What can and can’t go into AI tools, and who checks what', 'Workload and brain fry: fewer tools, set times to review AI work, and a cut-off time', 'When to deliberately not use AI', 'How to bring along colleagues who hesitate or push back', 'A first draft of your own team agreements on AI'], 60],
    ],
    termsH2: 'The psychology behind it',
    termsP: 'Most AI training is about what the tool can do. This one is also about what happens in your head while you use it. Four ideas that come back in the session:',
    terms: [
      ['Automation bias', 'The tendency to accept a system’s answer, even when your own knowledge says otherwise. The more convincing AI sounds, the stronger this gets.', trustArticle, 'More on trust in AI'],
      ['Algorithm aversion', 'The opposite: after one AI mistake you give up on it, while a colleague who makes the same mistake simply gets a second chance.', trustArticle, 'More on trust in AI'],
      ['Cognitive offloading', 'Handing thinking over to a tool. Often smart, but offload too early and too much and you think less critically.', thinkArticle, 'More on keeping your own judgement'],
      ['Motivational interviewing', 'A conversation method from psychology for helping people who are in two minds. In the session I use it to bring along colleagues who push back, without pushing them.', path('trainer', 'en'), 'About the trainer’s background'],
    ],
    literacyH2: 'Building AI literacy',
    literacyP: [
      'Since February 2025, the EU AI Act (Article 4) asks organisations that use AI to take steps on AI literacy among their staff. The law doesn’t prescribe a specific course. But you do need to be able to show what you’re doing about it.',
      'This training helps with that. Your team learns how AI works, where the risks are and which agreements you make together. You also get:',
    ],
    literacyItems: [
      'a certificate of attendance for every participant;',
      'a one-page report with the learning goals, attendees and the agreements you made, for your AI records.',
    ],
    literacyNote: 'This isn’t legal advice. What else your organisation needs depends on which AI systems you use and what for.',
    afterH2: 'What your team does differently afterwards',
    after: [
      'They ask AI better questions and spend less time rewriting.',
      'They know when an answer is good to use and when to double-check.',
      'They work to the same agreements, instead of everyone doing their own thing.',
      'They talk about it: what works, what doesn’t, and who can help whom.',
    ],
    notToolH2: 'Not a tool course',
    notToolP: 'There are good courses that walk you through Copilot in Word and Excel step by step. This is something else. It’s about how people work with AI: trust, habits and collaboration. Already done a tool course? This is the step that makes sure people actually use it. We work with whatever your team already has, whether that’s ChatGPT, Copilot, Gemini or something else.',
    practicalH2: 'The practical bits',
    specs: [
      ['length', 'half a day, 2–3 hours'],
      ['group', '8 to 16 people'],
      ['where', 'at your office'],
      ['language', 'English or Dutch'],
      ['materials', 'slides and worksheets in your house style'],
      ['includes', 'intake, four-week check-in, certificates and report'],
    ],
    priceLabel: 'from',
    price: '€1,250 excl. VAT per group',
    crossLabel: 'also available',
    crossH: 'Effective Meetings masterclass',
    crossP: 'The psychology of meetings, an agenda exercise and AI for minutes and action points. Book it on its own or together with this training.',
    crossCta: 'See the masterclass',
    faqH2: 'Frequently asked questions',
    faq: [
      ['Do people need to be using AI already?', 'No. The session works for complete beginners and for daily users alike. In a mixed group, people learn a lot from each other.'],
      ['What do you mean by “grounded in psychology”?', 'That the training isn’t only about what AI can do, but about what people do with it. Why do some trust it too much and others too little? Why does working with AI feel faster than it sometimes is? And how do you bring along colleagues who hesitate? That’s where my background in applied psychology comes in.'],
      ['Does the training help with AI literacy under the AI Act?', 'Yes. The AI Act asks organisations to take steps on AI literacy, but doesn’t prescribe a specific course. The training is a concrete step: every participant gets a certificate of attendance and you get a short report for your AI records. Whether that’s enough for your organisation depends on which AI you use and what for.'],
      ['Which AI tool do we use?', 'Whatever you already have: ChatGPT, Copilot, Gemini or something else. The approach works in any tool. If your organisation hasn’t picked one yet, we’ll talk about where to start during the intake.'],
      ['Are the materials in our own house style?', 'Yes. The slides and any worksheets get your colours and your logo. That’s included in the price, so the materials fit right in with your own documents afterwards.'],
      ['Does the training cover workload and the environment?', 'Yes. AI can increase workload, for example through all the checking, and every prompt costs electricity and water. We look at what research says and build it into your team agreements: fewer tools, set times to review AI work, and choosing when not to use AI.'],
      ['Is this a Copilot or ChatGPT course?', 'No. It isn’t a walkthrough of buttons and menus. It’s about how your team uses AI well and responsibly. It works well as a follow-up to a tool course.'],
      ['What does it cost?', 'From €1,250 excl. VAT per group, including the intake, the four-week check-in, certificates and the report. You’ll get the exact price after the intake.'],
      ['Can we combine this with the meetings masterclass?', 'Yes. Both trainings can be booked together, on the same day or a few weeks apart. We’ll work out what fits best during the intake.'],
      ['Where does it take place?', 'At your office. A room with a screen is all you need. Participants bring their own laptops.'],
      ['Can the training be in English?', 'Yes. The whole session can be run in English, which works well for international teams.'],
      ['What about our company data?', 'We practise without confidential information. What can and can’t go into AI tools is one of the things your team agrees on during the session.'],
      ['How soon can we schedule it?', 'Once you get in touch, you’ll hear from me within five working days. We then schedule the intake and find a date that works for you.'],
    ],
  },
}[lang];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: copy.h1,
    serviceType: lang === 'nl' ? 'Incompany AI-training' : 'In-house AI training',
    description: copy.description,
    provider: { '@id': `${site.url}/#organization` },
    areaServed: { '@type': 'Country', name: 'NL' },
    availableLanguage: ['nl', 'en'],
    about: lang === 'nl'
      ? ['AI-geletterdheid', 'Psychologie van AI-gebruik', 'Prompten', 'AI-afspraken in teams']
      : ['AI literacy', 'Psychology of AI use', 'Prompting', 'Team agreements on AI'],
    offers: {
      '@type': 'Offer',
      url: new URL(path('training', lang), site.url).href,
      priceSpecification: { '@type': 'PriceSpecification', minPrice: site.priceFrom, priceCurrency: site.currency, valueAddedTaxIncluded: false },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: lang === 'nl' ? 'nl-NL' : 'en',
    mainEntity: copy.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: site.name, item: new URL(path('home', lang), site.url).href },
      { '@type': 'ListItem', position: 2, name: copy.h1, item: new URL(path('training', lang), site.url).href },
    ],
  },
];
---
<Base lang={lang} title={copy.title} description={copy.description} schema={schema}>
  <div class="tp">
    <PageHead label={copy.label} title={copy.h1} lead={copy.lead} />

    <div class="wrap">
      <p class="proof label">
        {copy.proof.map((p) => <strong>{p}</strong>)}
        <a href={path('experiences', lang)}>{copy.proofLink}</a>
      </p>
    </div>

    <section class="wrap promo-video">
      <figure class="stack" style="--gap: 12px">
        <video
          class="promo-video__player"
          src={copy.video.src}
          poster={copy.video.poster}
          width="1920"
          height="1080"
          muted
          loop
          playsinline
          controls
          preload="none"
          aria-describedby="promo-video-desc"
        ></video>
        <figcaption class="label">{copy.video.caption}</figcaption>

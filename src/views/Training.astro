<script>
  // De video speelt vanzelf (zonder geluid) zodra hij in beeld is, en pauzeert als je wegscrolt.
  // Met "minder beweging" aan blijft hij stil staan. Wie zelf pauzeert, wordt niet overruled.
  const video = document.querySelector<HTMLVideoElement>('.promo-video__player');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (video && !calm && 'IntersectionObserver' in window) {
    let userPaused = false;
    let autoPausing = false;

    video.addEventListener('pause', () => {
      if (!autoPausing) userPaused = true;
      autoPausing = false;
    });
    video.addEventListener('play', () => { userPaused = false; });

    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting && !userPaused) {
          video.play().catch(() => {});
        } else if (!entry.isIntersecting && !video.paused) {
          autoPausing = true;
          video.pause();
        }
      },
      { threshold: 0.5 },
    ).observe(video);
  }
</script>

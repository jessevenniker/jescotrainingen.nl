---
// Homepage, versie "mens × machine" (najaar 2026), voor / en /en/.
// Elke tekst staat er twee keer in: L("Nederlands", "English"). Pas je de ene aan, pas dan ook de andere aan.
import Base from '../layouts/Base.astro';
import { path, counterpart, type Lang } from '../i18n';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource/kalam/400.css';
import '../styles/home-v2.css';
import TeamScan from '../components/TeamScan.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import trainerFoto from '../assets/images/jesse-whiteboard-uitsnede.jpg';
import ClientLogos from '../components/ClientLogos.astro';
import { site } from '../data/site';
import FigBrain from '../components/figures/FigBrain.astro';
import FigDay from '../components/figures/FigDay.astro';
import FigEnergy from '../components/figures/FigEnergy.astro';
import FigMachine from '../components/figures/FigMachine.astro';
import FigMap from '../components/figures/FigMap.astro';
import FigTrust from '../components/figures/FigTrust.astro';
import FigVenn from '../components/figures/FigVenn.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const L = (nl: string, en: string) => (lang === 'en' ? en : nl);

// Drie nieuwste kennisbankartikelen in deze taal (concepten tellen niet mee).
const knowledgeBase = path('knowledge', lang);
const latest = (await getCollection('kennisbank', (e) => e.data.lang === lang && !e.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const title = L('AI-training voor teams | Jesco Trainingen', 'AI training for teams | Jesco Trainingen');
const description = L(
  'Een training van een dagdeel over hoe AI denkt én hoe mensen denken: vertrouwen, prompten met eigen werk, werkdruk, milieu en samen afspraken maken. Vanaf €1.250 excl. btw per groep.',
  'A half-day training on how AI thinks and how people think: trust, prompting with your own work, workload, the environment and agreeing on how you use it. From €1,250 excl. VAT per group.',
);
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    url: site.url,
    name: site.name,
    inLanguage: ['nl-NL', 'en'],
    publisher: { '@id': `${site.url}/#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: L('AI in je werk: AI-training voor teams', 'AI at work: AI training for teams'),
    serviceType: L('Incompany AI-training', 'In-house AI training'),
    description,
    provider: { '@id': `${site.url}/#organization` },
    areaServed: { '@type': 'Country', name: 'NL' },
    availableLanguage: ['nl', 'en'],
    offers: {
      '@type': 'Offer',
      priceSpecification: { '@type': 'PriceSpecification', minPrice: site.priceFrom, priceCurrency: site.currency, valueAddedTaxIncluded: false },
    },
  },
];
---
<Base lang={lang} title={title} description={description} schema={schema}>
<div class="home-v2 anim-scroll">
<div style="background: #F7F5EF; color: #15201A">
<div class="loadbar" aria-hidden="true" style="height: 3px; background: #C6F36B"></div>

<section><div style="max-width: 1180px; margin: 0 auto; padding: 64px 40px 104px; box-sizing: border-box; display: flex; flex-direction: column; gap: 40px">
<div style="max-width: 880px; display: flex; flex-direction: column; gap: 24px"><div class="rise" style="--d:.1s"><span style="display: inline-flex; align-items: center; gap: 10px"><span style="display: inline-flex; align-items: center; gap: 8px; font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace; font-size: 14px; color: #183126"><span style="width: 8px; height: 16px; background: #183126"></span>{L("de machine", "the machine")}</span><span style="color: #5A665F">×</span><span style="font-family: 'Newsreader Variable', Newsreader, Georgia, serif; font-style: italic; font-size: 19px; color: #2F6B4A">{L("de mens", "the human")}</span></span></div>
<h1 class="rise" style="--d:.2s; margin: 0; font-family: 'Newsreader Variable', Newsreader, Georgia, serif; font-weight: 400; font-size: clamp(44px, 6vw, 80px); line-height: 1.02; letter-spacing: -0.025em; color: #15201A">{L("Iedereen in je team gebruikt AI. Ieder op zijn eigen manier.", "Everyone on your team uses AI. Each in their own way.")}</h1>
<p class="rise" style="--d:.35s; margin: 0; max-width: 660px; font-family: 'Instrument Sans Variable', 'Instrument Sans', system-ui, sans-serif; font-size: 20px; line-height: 1.6; color: #3A463F">{L("Een training van een dagdeel over hoe AI denkt én hoe mensen denken. Want of AI in je team gaat werken, hangt minder af van de tool dan van vertrouwen, gewoontes en afspraken. En van wat het doet met je werkdruk en het milieu.", "A half-day training on how AI thinks and how people think. Because whether AI works in your team depends less on the tool than on trust, habits and agreements. And on what it does to your workload and the environment.")}</p>
<div class="rise" style="--d:.5s; display: flex; flex-wrap: wrap; gap: 12px"><a href="#teamscan" style="display: inline-flex; align-items: center; min-height: 52px; padding: 0 24px; border-radius: 6px; font-family: 'Instrument Sans Variable', 'Instrument Sans', system-ui, sans-serif; font-size: 16px; font-weight: 500; text-decoration: none; background: #183126; color: #F7F5EF">{L("Doe de teamscan", "Take the team scan")}</a><a href={path('training', lang)} style="display: inline-flex; align-items: center; min-height: 52px; padding: 0 24px; border-radius: 6px; font-family: 'Instrument Sans Variable', 'Instrument Sans', system-ui, sans-serif; font-size: 16px; font-weight: 500; text-decoration: none; border: 1px solid #15201A; color: #15201A">{L("Bekijk de training", "See the training")}</a></div></div>
<figure style="margin: 0; padding-top: 32px; border-top: 1px solid #D8DCD3; display: flex; flex-direction: column; gap: 14px"><FigTrust lang={lang} /><figcaption style="max-width: 760px; font-family: 'Newsreader Variable', Newsreader, Georgia, serif; font-style: italic; font-size: 15px; line-height: 1.55; color: #5A665F">{L("Fig. 1 — Vertrouwen in AI tegen de kwaliteit van het werk. Schematisch, op basis van onderzoek naar algoritme-aversie en automation bias. Elk punt is een collega; na het dagdeel schuift het team op naar het midden.", "Fig. 1 — Trust in AI against the quality of the work. Schematic, based on research into algorithm aversion and automation bias. Each dot is a colleague; after the session, the team moves towards the middle.")}</figcaption></figure><div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 32px 40px"><div style="display: flex; flex-direction: column; gap: 10px; padding-top: 18px; border-top: 1px solid #D8DCD3"><span style="font-family: 'Newsreader Variable', Newsreader, Georgia, serif; font-size: 22px; color: #15201A">{L("Te weinig vertrouwen", "Too little trust")}</span><div style="font-family: 'Instrument Sans Variable', 'Instrument Sans', system-ui, sans-serif; font-size: 16px; line-height: 1.6; color: #3A463F">{L("Na één fout van een algoritme haken mensen sneller af dan na dezelfde fout van een collega", "After one mistake by an algorithm, people give up faster than after the same mistake by a colleague")}<sup style="font-family: 'Instrument Sans Variable', 'Instrument Sans', system-ui, sans-serif; font-size: 11px; color: #2F6B4A">[1]</sup>{L(". Het gevolg: AI wordt links gelaten bij taken waar het juist goed in is.", ". The result: AI gets ignored on tasks it is actually good at.")}</div></div><div style="display: flex; flex-direction: column; gap: 10px; padding-top: 18px; border-top: 1px solid #D8DCD3"><span style="font-family: 'Newsreader Variable', Newsreader, Georgia, serif; font-size: 22px; color: #15201A">{L("Juist vertrouwen", "The right trust")}</span><div style="font-family: 'Instrument Sans Variable', 'Instrument Sans', system-ui, sans-serif; font-size: 16px; line-height: 1.6; color: #3A463F">{L("Vertrouwen dat past bij de taak. Drie vragen helpen:", "Trust that fits the task. Three questions help:")}<ul style="margin: 6px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 8px"><li style="display: flex; gap: 12px"><span aria-hidden="true" style="flex: 0 0 6px; height: 6px; margin-top: 10px; border-radius: 50%; background: #2F6B4A"></span><span>{L("Kan ik het antwoord controleren?", "Can I check the answer?")}</span></li><li style="display: flex; gap: 12px"><span aria-hidden="true" style="flex: 0 0 6px; height: 6px; margin-top: 10px; border-radius: 50%; background: #2F6B4A"></span><span>{L("Wat gebeurt er als het fout is?", "What happens if it’s wrong?")}</span></li><li style="display: flex; gap: 12px"><span aria-hidden="true" style="flex: 0 0 6px; height: 6px; margin-top: 10px; border-radius: 50%; background: #2F6B4A"></span><span>{L("Weet ik zelf genoeg van dit onderwerp?", "Do I know enough about this topic myself?")}</span></li></ul></div></div><div style="display: flex; flex-direction: column; gap: 10px; padding-top: 18px; border-top: 1px solid #D8DCD3"><span style="font-family: 'Newsreader Variable', Newsreader, Georgia, serif; font-size: 22px; color: #15201A">{L("Te veel vertrouwen", "Too much trust")}</span><div style="font-family: 'Instrument Sans Variable', 'Instrument Sans', system-ui, sans-serif; font-size: 16px; line-height: 1.6; color: #3A463F">{L("Wat er verzorgd uitziet, nemen we makkelijk klakkeloos over", "What looks polished, we readily accept without question")}<sup style="font-family: 'Instrument Sans Variable', 'Instrument Sans', system-ui, sans-serif; font-size: 11px; color: #2F6B4A">[2]</sup>{L(". Bij taken buiten wat AI goed kan, kwamen consultants mét AI juist vaker tot een verkeerde oplossing", ". On tasks outside what AI does well, consultants using AI actually reached the wrong answer more often")}<sup style="font-family: 'Instrument Sans Variable', 'Instrument Sans', system-ui, sans-serif; font-size: 11px; color: #2F6B4A">[3]</sup>.</div></div></div><div style="max-width: 900px; font-family: 'Newsreader Variable', Newsreader, Georgia, serif; font-size: 14px; line-height: 1.6; color: #5A665F; display: flex; flex-direction: column; gap: 4px"><span>[1] Dietvorst, Simmons &amp; Massey (2015). Algorithm aversion. Journal of Experimental Psychology: General.</span><span>[2] Parasuraman &amp; Manzey (2010). Complacency and bias in human use of automation. Human Factors.</span><span>{L("[3] Dell’Acqua e.a. (2023). Navigating the jagged technological frontier. Harvard Business School.", "[3] Dell’Acqua et al. (2023). Navigating the jagged technological frontier. Harvard Business School.")}</span></div></div></section>
<section style="background: #E3EADF"><div style="max-width: 1180px; margin: 0 auto; padding: 104px 40px; box-sizing: border-box; display: flex; flex-direction: column; gap: 36px"><div style="max-width: 720px; display: flex; flex-direction: column; gap: 16px"><span style="display: inline-flex; align-items: center; gap: 10px"><span style="display: inline-flex; align-items: center; gap: 8px; font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace; font-size: 14px; color: #183126"><span style="width: 8px; height: 16px; background: #183126"></span>{L("de machine", "the machine")}</span><span style="color: #5A665F">×</span><span style="font-family: 'Newsreader Variable', Newsreader, Georgia, serif; font-style: italic; font-size: 19px; color: #2F6B4A">{L("de mens", "the human")}</span></span>
<h2 style="margin: 0; font-family: 'Newsreader Variable', Newsreader, Georgia, serif; font-weight: 400; font-size: clamp(32px, 4vw, 48px); line-height: 1.08; letter-spacing: -0.015em; color: #15201A">{L("Geen toolcursus. Geen verandertraject. Precies ertussen.", "Not a tool course. Not a change programme. Right in between.")}</h2><p style="margin: 0; font-family: 'Instrument Sans Variable', 'Instrument Sans', system-ui, sans-serif; font-size: 18px; line-height: 1.65; color: #3A463F">{L("Een toolcursus leert je de knoppen. Een verandertraject praat over mensen. Maar AI gaat pas werken als je team snapt hoe het model tot een antwoord komt, én waarom de een het blind vertrouwt en de ander na één fout afhaakt.", "A tool course teaches you the buttons. A change programme talks about people. But AI only starts working when your team understands how the model arrives at an answer, and why one person trusts it blindly while another gives up after one mistake.")}</p></div>
<figure style="margin: 0; display: flex; flex-direction: column; gap: 14px"><FigVenn lang={lang} /><figcaption style="max-width: 760px; font-family: 'Newsreader Variable', Newsreader, Georgia, serif; font-style: italic; font-size: 15px; line-height: 1.55; color: #5A665F">{L("Fig. 2 — Waar deze training zit.", "Fig. 2 — Where this training sits.")}</figcaption></figure></div></section>
<section style="background: #0F2219; color: #EEF2EA"><div style="max-width: 1180px; margin: 0 auto; padding: 104px 40px; box-sizing: border-box; display: flex; flex-direction: column; gap: 36px"><div style="max-width: 720px; display: flex; flex-direction: column; gap: 16px"><span style="display: inline-flex; align-items: center; gap: 8px; font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace; font-size: 14px; color: #C6F36B"><span style="width: 8px; height: 16px; background: #C6F36B"></span>{L("de machine", "the machine")}</span>
<h2 style="margin: 0; font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace; font-weight: 500; font-size: clamp(28px, 3.4vw, 42px); line-height: 1.12; letter-spacing: -0.02em; color: #EEF2EA">{L("Een taalmodel weet niets. Het voorspelt.", "A language model doesn’t know anything. It predicts.")}</h2><p style="margin: 0; font-family: 'Instrument Sans Variable', 'Instrument Sans', system-ui, sans-serif; font-size: 18px; line-height: 1.65; color: #9DB2A4">{L("Elk antwoord is een reeks gokken naar het meest waarschijnlijke volgende woord. Daarom klinkt AI altijd overtuigend, ook als het niet klopt. Wie dat snapt, weet wanneer je het kunt vertrouwen en wanneer je moet checken.", "Every answer is a chain of guesses at the most likely next word. That’s why AI always sounds convincing, even when it’s wrong. Once you get that, you know when to trust it and when to check.")}</p></div>
<figure style="margin: 0; display: flex; flex-direction: column; gap: 14px"><FigMachine lang={lang} /><figcaption style="max-width: 760px; font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace; font-size: 13px; line-height: 1.55; color: #9DB2A4">{L("fig. 3 — zo kiest een taalmodel het volgende woord. percentages zijn een voorbeeld.", "fig. 3 — how a language model picks the next word. the percentages are an example.")}</figcaption></figure><span style="font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace; font-size: 14px; color: #C6F36B">{L("wat dit betekent voor je werk", "what this means for your work")}</span><div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 32px 40px"><div style="display: flex; flex-direction: column; gap: 10px; padding-top: 18px; border-top: 1px solid #2E5442"><span style="font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace; font-size: 17px; font-weight: 500; color: #EEF2EA">{L("Het verzint soms dingen", "It sometimes makes things up")}</span><div style="font-family: 'Instrument Sans Variable', 'Instrument Sans', system-ui, sans-serif; font-size: 16px; line-height: 1.6; color: #9DB2A4">{L("Een model kiest woorden die waarschijnlijk klinken, geen feiten die het heeft opgezocht. Een bron, een cijfer of een citaat kan dus overtuigend kloppen, of overtuigend verzonnen zijn.", "A model picks words that sound likely, not facts it has looked up. So a source, a figure or a quote can be convincingly right, or convincingly made up.")}</div></div><div style="display: flex; flex-direction: column; gap: 10px; padding-top: 18px; border-top: 1px solid #2E5442"><span style="font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace; font-size: 17px; font-weight: 500; color: #EEF2EA">{L("Zelfde vraag, ander antwoord", "Same question, different answer")}</span><div style="font-family: 'Instrument Sans Variable', 'Instrument Sans', system-ui, sans-serif; font-size: 16px; line-height: 1.6; color: #9DB2A4">{L("Het volgende woord wordt telkens opnieuw gekozen. Stel je dezelfde vraag twee keer, dan krijg je vaak twee verschillende antwoorden. Handig voor ideeën, lastig voor afspraken.", "The next word is chosen afresh every time. Ask the same question twice and you’ll often get two different answers. Handy for ideas, awkward for agreements.")}</div></div><div style="display: flex; flex-direction: column; gap: 10px; padding-top: 18px; border-top: 1px solid #2E5442"><span style="font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace; font-size: 17px; font-weight: 500; color: #EEF2EA">{L("Het weet niet wat het niet weet", "It doesn’t know what it doesn’t know")}</span><div style="font-family: 'Instrument Sans Variable', 'Instrument Sans', system-ui, sans-serif; font-size: 16px; line-height: 1.6; color: #9DB2A4">{L("Een taalmodel geeft geen seintje als het twijfelt. De toon is even zeker bij iets wat klopt als bij iets wat niet klopt. Controleren blijft dus jouw werk.", "A language model doesn’t warn you when it’s unsure. It sounds just as certain about something right as about something wrong. So checking is still your job.")}</div></div></div></div></section>
<section style="background: #E3EADF"><div style="max-width: 1180px; margin: 0 auto; padding: 104px 40px; box-sizing: border-box; display: flex; flex-direction: column; gap: 36px"><div style="max-width: 720px; display: flex; flex-direction: column; gap: 16px"><span style="font-family: 'Newsreader Variable', Newsreader, Georgia, serif; font-style: italic; font-size: 19px; color: #2F6B4A">{L("de mens", "the human")}</span>
<h2 style="margin: 0; font-family: 'Newsreader Variable', Newsreader, Georgia, serif; font-weight: 400; font-size: clamp(32px, 4vw, 48px); line-height: 1.08; letter-spacing: -0.015em; color: #15201A">{L("Wat AI met je hoofd doet.", "What AI does to your head.")}</h2><p style="margin: 0; font-family: 'Instrument Sans Variable', 'Instrument Sans', system-ui, sans-serif; font-size: 18px; line-height: 1.65; color: #3A463F">{L("AI belooft minder werk, maar levert vaak ánder werk op: nakijken, schakelen, bijhouden. Wie de hele dag AI-output controleert, raakt sneller vermoeid. Onderzoekers noemen het AI brain fry. In de training leer je de signalen herkennen en maak je afspraken die de werkdruk beperken.", "AI promises less work, but often delivers different work: checking, switching, keeping track. If you spend all day checking AI output, you tire faster. Researchers call it AI brain fry. In the training you learn to recognise the signs and make agreements that keep the workload in check.")}</p></div>
<figure style="margin: 0; display: flex; flex-direction: column; gap: 14px"><FigBrain lang={lang} /><figcaption style="max-width: 760px; font-family: 'Newsreader Variable', Newsreader, Georgia, serif; font-style: italic; font-size: 15px; line-height: 1.55; color: #5A665F">{L("Fig. 3 — Wat veel toezicht op AI-werk vraagt. Zelfgerapporteerd. Brain fry is geen diagnose en geen burn-out, maar wel een signaal waar je als team iets aan kunt doen. Bron: Bedard e.a. (2026).", "Fig. 3 — What a lot of AI oversight takes out of you. Self-reported. Brain fry is not a diagnosis and not burnout, but it is a signal your team can do something about. Source: Bedard et al. (2026).")}</figcaption></figure><div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 32px 40px"><div style="display: flex; flex-direction: column; gap: 8px; padding-top: 18px; border-top: 1px solid #D8DCD3"><span style="font-family: 'Newsreader Variable', Newsreader, Georgia, serif; font-size: 56px; line-height: 1; color: #183126">77%</span><span style="font-family: 'Instrument Sans Variable', 'Instrument Sans', system-ui, sans-serif; font-size: 16px; line-height: 1.55; color: #3A463F">{L("van de werknemers die AI gebruiken zei dat hun werklast was toegenomen, onder meer door het nakijken van AI-teksten.", "of employees who use AI said their workload had gone up, partly because of checking AI-generated text.")}</span><span style="font-family: 'Newsreader Variable', Newsreader, Georgia, serif; font-style: italic; font-size: 14px; color: #5A665F">{L("Upwork Research Institute (2024). Enquête van een freelanceplatform.", "Upwork Research Institute (2024). Survey by a freelance platform.")}</span></div><div style="display: flex; flex-direction: column; gap: 8px; padding-top: 18px; border-top: 1px solid #D8DCD3"><span style="font-family: 'Newsreader Variable', Newsreader, Georgia, serif; font-size: 56px; line-height: 1; color: #183126">40%</span><span style="font-family: 'Instrument Sans Variable', 'Instrument Sans', system-ui, sans-serif; font-size: 16px; line-height: 1.55; color: #3A463F">{L("van de kantoormedewerkers kreeg de afgelopen maand “workslop”: werk dat er verzorgd uitziet, maar weinig toevoegt.", "of office workers received “workslop” in the past month: work that looks polished but adds little.")}</span><span style="font-family: 'Newsreader Variable', Newsreader, Georgia, serif; font-style: italic; font-size: 14px; color: #5A665F">{L("Niederhoffer e.a. (2025)", "Niederhoffer et al. (2025)")}</span></div><div style="display: flex; flex-direction: column; gap: 8px; padding-top: 18px; border-top: 1px solid #D8DCD3"><span style="font-family: 'Newsreader Variable', Newsreader, Georgia, serif; font-size: 56px; line-height: 1; color: #183126">4+</span><span style="font-family: 'Instrument Sans Variable', 'Instrument Sans', system-ui, sans-serif; font-size: 16px; line-height: 1.55; color: #3A463F">{L("AI-tools tegelijk: vanaf daar daalde de ervaren productiviteit sterk. Tot ongeveer drie tools ging die juist omhoog.", "AI tools at once: from there, perceived productivity dropped sharply. Up to about three tools, it actually went up.")}</span><span style="font-family: 'Newsreader Variable', Newsreader, Georgia, serif; font-style: italic; font-size: 14px; color: #5A665F">{L("Bedard e.a. (2026)", "Bedard et al. (2026)")}</span></div></div><span style="font-family: 'Newsreader Variable', Newsreader, Georgia, serif; font-style: italic; font-size: 19px; color: #2F6B4A">{L("wat helpt", "what helps")}</span><div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 32px 40px"><div style="display: flex; flex-direction: column; gap: 10px; padding-top: 18px; border-top: 1px solid #D8DCD3"><span style="font-family: 'Newsreader Variable', Newsreader, Georgia, serif; font-size: 22px; color: #15201A">{L("Minder tools, beter gebruikt", "Fewer tools, used better")}</span><div style="font-family: 'Instrument Sans Variable', 'Instrument Sans', system-ui, sans-serif; font-size: 16px; line-height: 1.6; color: #3A463F">{L("Kies samen een paar tools die echt passen, in plaats van overal een andere.", "Choose a few tools together that really fit, instead of a different one for everything.")}</div></div><div style="display: flex; flex-direction: column; gap: 10px; padding-top: 18px; border-top: 1px solid #D8DCD3"><span style="font-family: 'Newsreader Variable', Newsreader, Georgia, serif; font-size: 22px; color: #15201A">{L("Vaste blokken voor controle", "Set times for checking")}</span><div style="font-family: 'Instrument Sans Variable', 'Instrument Sans', system-ui, sans-serif; font-size: 16px; line-height: 1.6; color: #3A463F">{L("Loop AI-werk in blokken na, niet de hele dag tussendoor. En spreek af wat een grondige check nodig heeft.", "Review AI work in blocks, not in between all day. And agree on what needs a thorough check.")}</div></div><div style="display: flex; flex-direction: column; gap: 10px; padding-top: 18px; border-top: 1px solid #D8DCD3"><span style="font-family: 'Newsreader Variable', Newsreader, Georgia, serif; font-size: 22px; color: #15201A">{L("Een eindtijd voor AI-werk", "A cut-off time for AI work")}</span><div style="font-family: 'Instrument Sans Variable', 'Instrument Sans', system-ui, sans-serif; font-size: 16px; line-height: 1.6; color: #3A463F">{L("Bundel AI-werk overdag en stuur ’s avonds geen berichten. Zo kan iedereen mentaal loskomen van het werk.", "Bundle AI work during the day and don’t send messages in the evening. That way everyone can switch off from work.")}</div></div></div><a href={counterpart('/kennisbank/ai-brain-fry-als-toezicht-op-ai-je-hoofd-laat-koken/', lang)} style="align-self: flex-start; font-family: 'Instrument Sans Variable', 'Instrument Sans', system-ui, sans-serif; font-size: 16px; color: #2F6B4A; text-underline-offset: 4px">{L("Lees meer over AI brain fry →", "Read more about AI brain fry →")}</a></div></section>
<section style="background: #0F2219; color: #EEF2EA"><div style="max-width: 1180px; margin: 0 auto; padding: 104px 40px; box-sizing: border-box; display: flex; flex-direction: column; gap: 36px"><div style="max-width: 720px; display: flex; flex-direction: column; gap: 16px"><span style="display: inline-flex; align-items: center; gap: 8px; font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace; font-size: 14px; color: #C6F36B"><span style="width: 8px; height: 16px; background: #C6F36B"></span>{L("de machine", "the machine")}</span>
<h2 style="margin: 0; font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace; font-weight: 500; font-size: clamp(28px, 3.4vw, 42px); line-height: 1.12; letter-spacing: -0.02em; color: #EEF2EA">{L("Elke vraag kost stroom en water.", "Every prompt costs electricity and water.")}</h2><p style="margin: 0; font-family: 'Instrument Sans Variable', 'Instrument Sans', system-ui, sans-serif; font-size: 18px; line-height: 1.65; color: #9DB2A4">{L("Per vraag is het weinig. Maar AI wordt miljarden keren per dag gebruikt, en datacenters groeien hard. Bewust gebruik is dus niet alleen beter voor je werk en je hoofd, maar ook voor het milieu.", "Per prompt, it’s not much. But AI is used billions of times a day, and data centres are growing fast. So deliberate use isn’t just better for your work and your head, but for the environment too.")}</p></div>
<figure style="margin: 0; display: flex; flex-direction: column; gap: 14px"><FigEnergy lang={lang} /><figcaption style="max-width: 760px; font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace; font-size: 13px; line-height: 1.55; color: #9DB2A4">{L("fig. 6 — één tekstvraag: cijfers van google voor gemini (mei 2025), niet onafhankelijk gecontroleerd. datacenters: iea, energy and ai (2025).", "fig. 6 — one text prompt: google’s figures for gemini (may 2025), not independently verified. data centres: iea, energy and ai (2025).")}</figcaption></figure><span style="font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace; font-size: 14px; color: #C6F36B">{L("bewust kiezen", "choosing deliberately")}</span><div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 32px 40px"><div style="display: flex; flex-direction: column; gap: 10px; padding-top: 18px; border-top: 1px solid #2E5442"><span style="font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace; font-size: 17px; font-weight: 500; color: #EEF2EA">{L("Niet elke taak vraagt om AI", "Not every task needs AI")}</span><div style="font-family: 'Instrument Sans Variable', 'Instrument Sans', system-ui, sans-serif; font-size: 16px; line-height: 1.6; color: #9DB2A4">{L("Een mail van drie zinnen schrijf je vaak sneller zelf. Bewust kiezen bespaart tijd, stroom en controlewerk.", "A three-sentence email is often quicker to write yourself. Choosing deliberately saves time, electricity and checking.")}</div></div><div style="display: flex; flex-direction: column; gap: 10px; padding-top: 18px; border-top: 1px solid #2E5442"><span style="font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace; font-size: 17px; font-weight: 500; color: #EEF2EA">{L("Eerst denken, dan prompten", "Think first, then prompt")}</span><div style="font-family: 'Instrument Sans Variable', 'Instrument Sans', system-ui, sans-serif; font-size: 16px; line-height: 1.6; color: #9DB2A4">{L("Een goede vraag in één keer scheelt vijf keer opnieuw genereren. Dat is beter voor het resultaat én voor het verbruik.", "One good question saves regenerating five times. That’s better for the result and for the energy use.")}</div></div><div style="display: flex; flex-direction: column; gap: 10px; padding-top: 18px; border-top: 1px solid #2E5442"><span style="font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace; font-size: 17px; font-weight: 500; color: #EEF2EA">{L("Beeld en video kosten meer", "Images and video cost more")}</span><div style="font-family: 'Instrument Sans Variable', 'Instrument Sans', system-ui, sans-serif; font-size: 16px; line-height: 1.6; color: #9DB2A4">{L("De cijfers hierboven gaan over één tekstvraag. Het maken van beelden en video vraagt doorgaans veel meer rekenkracht.", "The figures above are for one text prompt. Generating images and video usually takes far more computing power.")}</div></div></div><a href={counterpart('/kennisbank/wat-kost-ai-aan-stroom-en-water/', lang)} style="align-self: flex-start; font-family: 'Instrument Sans Variable', 'Instrument Sans', system-ui, sans-serif; font-size: 16px; color: #C6F36B; text-underline-offset: 4px">{L("Lees meer: wat kost een AI-vraag aan stroom en water? →", "Read more: what does an AI prompt cost in electricity and water? →")}</a></div></section>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ScanStrip from '../components/ScanStrip.astro';
import { path, type Lang } from '../i18n';
import { site } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const locale = lang === 'nl' ? 'nl-NL' : 'en-GB';

const articles = (await getCollection('kennisbank', (e) => e.data.lang === lang))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const minutes = (body?: string) => Math.max(1, Math.round((body ?? '').split(/\s+/).filter(Boolean).length / 200));
const fmt = (d: Date) => d.toLocaleDateString(locale, { day: 'numeric', month: 'long', year: 'numeric' });
const [featured, ...rest] = articles;

const copy = {
  nl: {
    title: 'Kennisbank: AI, gedrag en werk | Jesco Trainingen',
    description: 'Artikelen over de psychologie van AI op het werk: vertrouwen, gewoontes, weerstand en goed prompten. Onderbouwd met onderzoek, elke maand een nieuw stuk.',
    label: 'kennisbank',
    h1: 'AI, gedrag en werk.',
    lead: 'Over hoe mensen met AI werken: vertrouwen, gewoontes, weerstand en goed prompten. Onderbouwd met onderzoek. Elke maand een nieuw artikel.',
    read: 'Lees artikel',
    latest: 'nieuwste',
    min: 'min lezen',
  },
  en: {
    title: 'Insights: AI, behaviour and work | Jesco Trainingen',
    description: 'Articles on the psychology of AI at work: trust, habits, resistance and better prompting. Backed by research, with a new piece every month.',
    label: 'insights',
    h1: 'AI, behaviour and work.',
    lead: 'On how people work with AI: trust, habits, resistance and better prompting. Backed by research. A new article every month.',
    read: 'Read article',
    latest: 'latest',
    min: 'min read',
  },
}[lang];

const base = path('knowledge', lang);
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: copy.h1,
    url: new URL(base, site.url).href,
    inLanguage: lang === 'nl' ? 'nl-NL' : 'en',
    publisher: { '@id': `${site.url}/#organization` },
    blogPost: articles.map((a) => ({ '@type': 'BlogPosting', headline: a.data.title, url: new URL(`${base}${a.id}/`, site.url).href, datePublished: a.data.date.toISOString().slice(0, 10) })),
  },
];
---
<Base lang={lang} title={copy.title} description={copy.description} schema={schema}>
  <PageHead label={copy.label} title={copy.h1} lead={copy.lead} />
  <section class="wrap section kb">
    {featured && (
      <a class="feature" href={`${base}${featured.id}/`}>
        <div class="feature__meta">
          <span class="feature__tag">{copy.latest}</span>
          <span class="label">{fmt(featured.data.date)} · {featured.data.cluster} · {minutes(featured.body)} {copy.min}</span>
        </div>
        <h2 class="feature__title">{featured.data.title}</h2>
        <p class="feature__desc">{featured.data.description}</p>
        {featured.data.summary.length > 0 && (
          <ol class="feature__points">
            {featured.data.summary.map((p) => <li>{p}</li>)}
          </ol>
        )}
        <span class="feature__read">{copy.read} →</span>
      </a>
    )}
    <ul class="articles">
      {rest.map((a) => (
        <li>
          <a href={`${base}${a.id}/`} class="article-row">
            <span class="label">{fmt(a.data.date)} · {a.data.cluster} · {minutes(a.body)} {copy.min}</span>
            <h2>{a.data.title}</h2>
            <p>{a.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
  <ScanStrip lang={lang} />
</Base>

<style>
  .kb { display: flex; flex-direction: column; gap: clamp(40px, 5vw, 64px); }
  .feature { display: flex; flex-direction: column; gap: 16px; padding: clamp(24px, 4vw, 48px); border-radius: 8px; background: var(--forest); color: var(--on-dark); text-decoration: none; }
  .feature:hover { color: var(--on-dark); }
  .feature__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; }
  .feature__meta .label { color: var(--on-dark-3); }
  .feature__tag { font-family: var(--mono); font-size: 0.75rem; padding: 3px 8px; border-radius: 3px; background: var(--lime); color: var(--night); }
  .feature__title { font-size: clamp(2rem, 4vw, 3.4rem); max-width: 18em; }
  .feature__desc { color: var(--on-dark-2); font-size: 1.1rem; line-height: 1.55; max-width: 44rem; }
  .feature__points { margin: 8px 0 0; padding: 18px 0 0; border-top: 1px solid var(--dark-rule); list-style: none; counter-reset: f; display: flex; flex-wrap: wrap; gap: 16px 32px; }
  .feature__points li { counter-increment: f; flex: 1 1 240px; min-width: 0; display: flex; gap: 12px; font-size: 0.98rem; line-height: 1.5; color: var(--on-dark); }
  .feature__points li::before { content: counter(f); font-family: var(--mono); font-size: 0.8125rem; color: var(--lime); padding-top: 0.15em; }
  .feature__read { font-weight: 600; color: var(--lime); margin-top: 4px; }
  .feature:hover .feature__title { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.15em; }
  .articles { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
  .articles li { border-bottom: 1px solid var(--rule); }
  .article-row { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; padding: 32px 0; text-decoration: none; max-width: 52rem; }
  .article-row h2 { font-size: clamp(1.6rem, 3vw, 2.4rem); }
  .article-row p { color: var(--ink-2); line-height: 1.6; }
  .article-row:hover h2 { color: var(--green); }
</style>

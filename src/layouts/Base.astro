---
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { alternatesFor } from '../i18n/routes.mjs';
import { htmlLang, ogLocale, path, type Lang } from '../i18n';
import { t } from '../i18n/ui';
import { site } from '../data/site';
import { ogKeyFor } from '../lib/og';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  schema?: Record<string, unknown>[];
  ogType?: 'website' | 'article';
  noindex?: boolean;
}
const { lang, title, description, schema = [], ogType = 'website', noindex = false } = Astro.props;
const s = t(lang);
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, site.url).href;
const alternates = alternatesFor(pathname);
// Deelafbeelding per pagina, gemaakt door src/pages/og/[key].png.ts.
const ogUrl = new URL(`/og/${ogKeyFor(pathname, lang)}.png`, site.url).href;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.name,
  legalName: site.legalName,
  url: site.url,
  email: site.email,
  logo: `${site.url}/logo.svg`,
  founder: { '@id': `${site.url}/#jesse` },
  knowsLanguage: ['nl', 'en'],
  ...(site.kvk ? { identifier: { '@type': 'PropertyValue', propertyID: 'KvK', value: site.kvk } } : {}),
};
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.url}/#jesse`,
  name: site.trainer,
  url: new URL(path('trainer', lang), site.url).href,
  sameAs: [site.trainerLinkedIn],
  jobTitle: lang === 'nl' ? 'Trainer AI en gedrag' : 'Trainer, AI and behaviour',
  worksFor: { '@id': `${site.url}/#organization` },
  // Student aan de HAN (afstuderen 2027), dus 'affiliation' en nog geen 'alumniOf'.
  affiliation: { '@type': 'CollegeOrUniversity', name: 'HAN University of Applied Sciences', url: 'https://www.han.nl/' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Wollongong', url: 'https://www.uow.edu.au/' },
  knowsAbout: [
    'Generative AI', 'Prompting', 'Technology adoption', 'Applied psychology', 'Team learning',
    'Behaviour change', 'Motivational interviewing', 'Solution-focused coaching', 'Learning design', 'App development',
  ],
  knowsLanguage: ['nl', 'en'],
};
---
<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {alternates && alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={new URL(a.path, site.url).href} />)}
    {alternates && <link rel="alternate" hreflang="x-default" href={new URL(alternates[0].path, site.url).href} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#183126" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    {schema.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">{s.skip}</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <Analytics />
  </body>
</html>

---
// Figuur voor de homepage. Aantekeningen in currentColor: de kleur komt van --marker.
import type { Lang } from '../../i18n';
interface Props { lang?: Lang }
const { lang = 'nl' } = Astro.props;
const L = (nl: string, en: string) => (lang === 'en' ? en : nl);
---
<svg viewBox="0 0 1100 300" width="100%" role="img" aria-label={L("Figuur: het dagdeel van drie uur in drie delen, van machine naar mens.", "Figure: the three-hour session in three parts, from machine to human.")}><line x1="80" y1="200" x2="1070" y2="200" stroke="#15201A" stroke-width="1" pathLength="1" class="draw" style="--d:0.00s"></line><line x1="80.0" y1="194" x2="80.0" y2="206" stroke="#15201A" pathLength="1" class="draw" style="--d:0.04s"></line><text x="80.0" y="228" font-family="Instrument Sans, sans-serif" font-size="13" fill="#5A665F" text-anchor="middle" class="fade" style="--d:0.15s">0:00</text><line x1="327.5" y1="194" x2="327.5" y2="206" stroke="#15201A" pathLength="1" class="draw" style="--d:0.08s"></line><text x="327.5" y="228" font-family="Instrument Sans, sans-serif" font-size="13" fill="#5A665F" text-anchor="middle" class="fade" style="--d:0.20s">0:45</text><line x1="740.0" y1="194" x2="740.0" y2="206" stroke="#15201A" pathLength="1" class="draw" style="--d:0.12s"></line><text x="740.0" y="228" font-family="Instrument Sans, sans-serif" font-size="13" fill="#5A665F" text-anchor="middle" class="fade" style="--d:0.25s">2:00</text><line x1="1070.0" y1="194" x2="1070.0" y2="206" stroke="#15201A" pathLength="1" class="draw" style="--d:0.16s"></line><text x="1070.0" y="228" font-family="Instrument Sans, sans-serif" font-size="13" fill="#5A665F" text-anchor="middle" class="fade" style="--d:0.30s">3:00</text><rect x="83.0" y="164" width="120.75" height="26" fill="#183126" class="grow" style="--d:0.60s"></rect><rect x="203.75" y="164" width="120.75" height="26" fill="#9DBF9A" class="grow" style="--d:0.72s"></rect><text x="83.0" y="148" font-family="JetBrains Mono, monospace" font-size="12" fill="#5A665F" class="fade" style="--d:0.35s">{L("machine + mens", "machine + human")}</text><text x="83.0" y="262" font-family="Instrument Sans, sans-serif" font-size="16" fill="#15201A" text-anchor="start" class="fade" style="--d:0.40s">{L("Hoe AI denkt", "How AI thinks")}</text><rect x="330.5" y="164" width="406.5" height="26" fill="#183126" class="grow" style="--d:0.84s"></rect><text x="330.5" y="148" font-family="JetBrains Mono, monospace" font-size="12" fill="#5A665F" class="fade" style="--d:0.45s">machine</text><text x="330.5" y="262" font-family="Instrument Sans, sans-serif" font-size="16" fill="#15201A" text-anchor="start" class="fade" style="--d:0.50s">{L("Prompten met eigen werk", "Prompting with your own work")}</text><rect x="743.0" y="164" width="324.0" height="26" fill="#9DBF9A" class="grow" style="--d:0.96s"></rect><text x="743.0" y="148" font-family="JetBrains Mono, monospace" font-size="12" fill="#5A665F" class="fade" style="--d:0.55s">{L("mens", "human")}</text><text x="743.0" y="262" font-family="Instrument Sans, sans-serif" font-size="16" fill="#15201A" text-anchor="start" class="fade" style="--d:0.60s">{L("Afspraken en het gesprek", "Agreements and the conversation")}</text><g class="write" style="--d:2.00s"><text x="347.5" y="90" font-family="Kalam, Caveat, cursive" font-size="28" fill="currentColor" text-anchor="start" transform="rotate(-2 347.5 90)">{L("neem een echte taak mee!", "bring a real task!")}</text></g><g class="write" style="--d:2.40s"><text x="760.0" y="120" font-family="Kalam, Caveat, cursive" font-size="28" fill="currentColor" text-anchor="start" transform="rotate(-3 760.0 120)">{L("op één A4", "on one page")}</text></g><path d="M 477.5 100 Q 497.5 130 477.5 158" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" pathLength="1" class="drawm" style="--d:1.70s"></path><path d="M 479.9 144.2 L 477.5 158 L 489.8 151.3" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" pathLength="1" class="drawm" style="--d:2.05s"></path><rect x="80" y="20" width="16" height="12" fill="#183126" class="grow" style="--d:1.08s"></rect><text x="102" y="31" font-family="JetBrains Mono, monospace" font-size="12" fill="#5A665F" text-anchor="start" class="fade" style="--d:0.65s">machine</text><rect x="190" y="20" width="16" height="12" fill="#9DBF9A" class="grow" style="--d:1.20s"></rect><text x="212" y="31" font-family="Instrument Sans, sans-serif" font-size="13" fill="#5A665F" text-anchor="start" class="fade" style="--d:0.70s">{L("mens", "human")}</text></svg>

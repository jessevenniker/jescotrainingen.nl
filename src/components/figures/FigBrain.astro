---
// Figuur voor de homepage. Aantekeningen in currentColor: de kleur komt van --marker.
import type { Lang } from '../../i18n';
interface Props { lang?: Lang }
const { lang = 'nl' } = Astro.props;
const L = (nl: string, en: string) => (lang === 'en' ? en : nl);
---
<svg viewBox="0 0 1100 380" width="100%" role="img" aria-label={L("Figuur: wie veel AI-werk controleert, rapporteert 14 procent meer mentale inspanning, 12 procent meer mentale vermoeidheid en 19 procent meer informatie-overload. Bij brain fry heeft 34 procent de intentie te vertrekken, tegenover 25 procent zonder.", "Figure: people who check a lot of AI work report 14 percent more mental effort, 12 percent more mental fatigue and 19 percent more information overload. With brain fry, 34 percent intend to leave, compared with 25 percent without.")}><line x1="300" y1="40" x2="300" y2="250" stroke="#15201A" pathLength="1" class="draw" style="--d:0.00s"></line><text x="284" y="86" font-family="Instrument Sans, sans-serif" font-size="16" fill="#15201A" text-anchor="end" class="fade" style="--d:0.15s">{L("mentale inspanning", "mental effort")}</text><rect x="300" y="70" width="196" height="24" fill="#183126" class="grow" style="--d:0.60s"></rect><text x="506" y="88" font-family="Instrument Sans, sans-serif" font-size="16" fill="#15201A" text-anchor="start" class="fade" style="--d:0.20s">+14%</text><text x="284" y="146" font-family="Instrument Sans, sans-serif" font-size="16" fill="#15201A" text-anchor="end" class="fade" style="--d:0.25s">{L("mentale vermoeidheid", "mental fatigue")}</text><rect x="300" y="130" width="168" height="24" fill="#183126" class="grow" style="--d:0.72s"></rect><text x="478" y="148" font-family="Instrument Sans, sans-serif" font-size="16" fill="#15201A" text-anchor="start" class="fade" style="--d:0.30s">+12%</text><text x="284" y="206" font-family="Instrument Sans, sans-serif" font-size="16" fill="#15201A" text-anchor="end" class="fade" style="--d:0.35s">{L("informatie-overload", "information overload")}</text><rect x="300" y="190" width="266" height="24" fill="#183126" class="grow" style="--d:0.84s"></rect><text x="576" y="208" font-family="Instrument Sans, sans-serif" font-size="16" fill="#15201A" text-anchor="start" class="fade" style="--d:0.40s">+19%</text><text x="300" y="280" font-family="Instrument Sans, sans-serif" font-size="13" fill="#5A665F" text-anchor="start" class="fade" style="--d:0.45s">{L("meer dan bij wie weinig AI-werk controleert", "more than people who check little AI work")}</text><line x1="780" y1="250" x2="1060" y2="250" stroke="#15201A" pathLength="1" class="draw" style="--d:0.04s"></line><rect x="800" y="110.0" width="90" height="140.0" fill="#9DBF9A" class="growy" style="--d:1.10s"></rect><text x="845" y="100.0" font-family="Instrument Sans, sans-serif" font-size="18" fill="#15201A" text-anchor="middle" class="fade" style="--d:0.50s">25%</text><text x="845" y="272" font-family="Instrument Sans, sans-serif" font-size="13" fill="#5A665F" text-anchor="middle" class="fade" style="--d:0.55s">{L("zonder brain fry", "without brain fry")}</text><rect x="930" y="59.60000000000002" width="90" height="190.39999999999998" fill="#183126" class="growy" style="--d:1.30s"></rect><text x="975" y="49.60000000000002" font-family="Instrument Sans, sans-serif" font-size="18" fill="#15201A" text-anchor="middle" class="fade" style="--d:0.60s">34%</text><text x="975" y="272" font-family="Instrument Sans, sans-serif" font-size="13" fill="#5A665F" text-anchor="middle" class="fade" style="--d:0.65s">{L("met brain fry", "with brain fry")}</text><text x="910" y="300" font-family="Instrument Sans, sans-serif" font-size="14" fill="#5A665F" text-anchor="middle" class="fade" style="--d:0.70s">{L("van plan om te vertrekken", "planning to leave")}</text><path d="M 933.2 40.00000000000002 C 935.4 16.000000000000025, 1012.4 14.800000000000026, 1019.88 42.40000000000002 C 1022.52 68.80000000000003, 942.0 71.20000000000002, 931.0 46.00000000000002 C 928.8 35.200000000000024, 948.6 20.800000000000026, 966.2 17.68000000000002" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" pathLength="1" class="drawm" style="--d:1.70s"></path><g class="write" style="--d:2.00s"><text x="300" y="340" font-family="Kalam, Caveat, cursive" font-size="28" fill="currentColor" text-anchor="start" transform="rotate(-2 300 340)">{L("toezicht houden is óók werk", "oversight is work too")}</text></g></svg>

---
// Figuur voor de homepage. Aantekeningen in currentColor: de kleur komt van --marker.
import type { Lang } from '../../i18n';
interface Props { lang?: Lang }
const { lang = 'nl' } = Astro.props;
const L = (nl: string, en: string) => (lang === 'en' ? en : nl);
---
<svg viewBox="0 0 1100 440" width="100%" role="img" aria-label={L("Figuur: twee cirkels, hoe AI werkt en hoe mensen werken. De training zit in de overlap.", "Figure: two circles, how AI works and how people work. The training sits where they overlap.")}><circle cx="430" cy="220" r="185" fill="#183126" fill-opacity="0.08" stroke="#183126" stroke-width="1.6" class="fade" style="--d:0.10s"></circle><circle cx="670" cy="220" r="185" fill="#2F6B4A" fill-opacity="0.10" stroke="#2F6B4A" stroke-width="1.6" class="fade" style="--d:0.10s"></circle><text x="330" y="150" font-family="JetBrains Mono, monospace" font-size="15" fill="#183126" text-anchor="middle" class="fade" style="--d:0.15s">{L("hoe AI werkt", "how AI works")}</text><text x="330" y="190" font-family="Instrument Sans, sans-serif" font-size="15" fill="#15201A" text-anchor="middle" class="fade" style="--d:0.20s">{L("taalmodellen", "language models")}</text><text x="330" y="216" font-family="Instrument Sans, sans-serif" font-size="15" fill="#15201A" text-anchor="middle" class="fade" style="--d:0.25s">{L("prompten", "prompting")}</text><text x="330" y="242" font-family="Instrument Sans, sans-serif" font-size="15" fill="#15201A" text-anchor="middle" class="fade" style="--d:0.30s">{L("grenzen en kosten", "limits and costs")}</text><text x="770" y="150" font-family="Newsreader, serif" font-style="italic" font-size="19" fill="#2F6B4A" text-anchor="middle" class="fade" style="--d:0.35s">{L("hoe mensen werken", "how people work")}</text><text x="770" y="190" font-family="Instrument Sans, sans-serif" font-size="15" fill="#15201A" text-anchor="middle" class="fade" style="--d:0.40s">{L("vertrouwen", "trust")}</text><text x="770" y="216" font-family="Instrument Sans, sans-serif" font-size="15" fill="#15201A" text-anchor="middle" class="fade" style="--d:0.45s">{L("gewoontes", "habits")}</text><text x="770" y="242" font-family="Instrument Sans, sans-serif" font-size="15" fill="#15201A" text-anchor="middle" class="fade" style="--d:0.50s">{L("welzijn", "wellbeing")}</text><text x="550" y="214" font-family="Newsreader, serif" font-size="22" fill="#15201A" text-anchor="middle" class="fade" style="--d:0.55s">{L("deze", "this")}</text><text x="550" y="242" font-family="Newsreader, serif" font-size="22" fill="#15201A" text-anchor="middle" class="fade" style="--d:0.60s">training</text><path d="M 483.5 217.3 C 487.0 159.3, 609.5 156.4, 621.4 223.1 C 625.6 286.9, 497.5 292.7, 480.0 231.8 C 476.5 205.7, 508.0 170.9, 536.0 163.36" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" pathLength="1" class="drawm" style="--d:1.70s"></path><g class="write" style="--d:2.00s"><text x="640" y="40" font-family="Kalam, Caveat, cursive" font-size="28" fill="currentColor" text-anchor="start" transform="rotate(-3 640 40)">{L("hier zit het verschil", "where the difference is made")}</text></g><path d="M 680 52 Q 640 110 585 165" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" pathLength="1" class="drawm" style="--d:2.05s"></path><path d="M 589.6 151.8 L 585 165 L 598.2 160.4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" pathLength="1" class="drawm" style="--d:2.40s"></path><text x="90" y="400" font-family="Instrument Sans, sans-serif" font-size="14" fill="#5A665F" text-anchor="start" class="fade" style="--d:0.65s">{L("toolcursus: alleen links", "tool course: left only")}</text><text x="1010" y="400" font-family="Instrument Sans, sans-serif" font-size="14" fill="#5A665F" text-anchor="end" class="fade" style="--d:0.70s">{L("verandertraject: alleen rechts", "change programme: right only")}</text></svg>

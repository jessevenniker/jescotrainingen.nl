---
// Figuur voor de homepage. Aantekeningen in currentColor: de kleur komt van --marker.
import type { Lang } from '../../i18n';
interface Props { lang?: Lang }
const { lang = 'nl' } = Astro.props;
const L = (nl: string, en: string) => (lang === 'en' ? en : nl);
---
<svg viewBox="0 0 320 200" width="100%" role="img" aria-label={L("Schematische figuur", "Schematic figure")}><line x1="30" y1="170" x2="310" y2="170" stroke="#15201A" pathLength="1" class="draw" style="--d:0.00s"></line><line x1="30" y1="15" x2="30" y2="170" stroke="#15201A" pathLength="1" class="draw" style="--d:0.04s"></line><path d="M30 40 C 120 44, 170 80, 310 160" fill="none" stroke="#183126" stroke-width="2.5" pathLength="1" class="draw" style="--d:0.30s"></path><text x="310" y="188" font-family="Instrument Sans, sans-serif" font-size="12" fill="#5A665F" text-anchor="end" class="fade" style="--d:0.15s">{L("aantal tools", "number of tools")}</text><text x="36" y="30" font-family="Instrument Sans, sans-serif" font-size="12" fill="#5A665F" text-anchor="start" class="fade" style="--d:0.20s">focus</text><g class="write" style="--d:2.00s"><text x="150" y="130" font-family="Kalam, Caveat, cursive" font-size="22" fill="currentColor" text-anchor="start" transform="rotate(-4 150 130)">{L("nog één tool…", "one more tool…")}</text></g></svg>

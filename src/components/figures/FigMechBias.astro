---
// Figuur voor de homepage. Aantekeningen in currentColor: de kleur komt van --marker.
import type { Lang } from '../../i18n';
interface Props { lang?: Lang }
const { lang = 'nl' } = Astro.props;
const L = (nl: string, en: string) => (lang === 'en' ? en : nl);
---
<svg viewBox="0 0 320 200" width="100%" role="img" aria-label={L("Schematische figuur", "Schematic figure")}><line x1="30" y1="170" x2="310" y2="170" stroke="#15201A" pathLength="1" class="draw" style="--d:0.00s"></line><line x1="30" y1="15" x2="30" y2="170" stroke="#15201A" pathLength="1" class="draw" style="--d:0.04s"></line><rect x="70" y="40" width="70" height="130" fill="#2F6B4A" class="growy" style="--d:0.50s"></rect><rect x="200" y="110" width="70" height="60" fill="#183126" class="growy" style="--d:0.70s"></rect><text x="105" y="188" font-family="Instrument Sans, sans-serif" font-size="12" fill="#5A665F" text-anchor="middle" class="fade" style="--d:0.15s">{L("ruw concept", "rough draft")}</text><text x="235" y="188" font-family="Instrument Sans, sans-serif" font-size="12" fill="#5A665F" text-anchor="middle" class="fade" style="--d:0.20s">{L("verzorgd", "polished")}</text><text x="36" y="30" font-family="Instrument Sans, sans-serif" font-size="12" fill="#5A665F" text-anchor="start" class="fade" style="--d:0.25s">{L("wordt gecheckt", "gets checked")}</text><g class="write" style="--d:2.00s"><text x="150" y="96" font-family="Kalam, Caveat, cursive" font-size="22" fill="currentColor" text-anchor="start" transform="rotate(-4 150 96)">{L("ziet er goed uit…", "looks fine…")}</text></g></svg>

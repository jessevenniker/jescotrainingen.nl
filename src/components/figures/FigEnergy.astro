---
// Figuur voor de homepage. Aantekeningen in currentColor: de kleur komt van --marker.
import type { Lang } from '../../i18n';
interface Props { lang?: Lang }
const { lang = 'nl' } = Astro.props;
const L = (nl: string, en: string) => (lang === 'en' ? en : nl);
---
<svg viewBox="0 0 1100 430" width="100%" role="img" aria-label={L("Figuur: één gemiddelde tekstvraag aan Gemini kost volgens Google 0,24 wattuur en 0,26 milliliter water. Datacenters gebruikten in 2024 415 terawattuur, in 2030 naar verwachting 945.", "Figure: according to Google, one average text prompt to Gemini uses 0.24 watt-hours and 0.26 millilitres of water. Data centres used 415 terawatt-hours in 2024, and are expected to use 945 in 2030.")}><text x="80" y="50" font-family="JetBrains Mono, monospace" font-size="14" fill="#9DB2A4" text-anchor="start" class="fade" style="--d:0.15s">{L("één tekstvraag (mediaan)", "one text prompt (median)")}</text><text x="80" y="120" font-family="JetBrains Mono, monospace" font-size="52" fill="#EEF2EA" class="fade" style="--d:0.20s">{L("0,24 Wh", "0.24 Wh")}</text><text x="80" y="148" font-family="JetBrains Mono, monospace" font-size="15" fill="#9DB2A4" text-anchor="start" class="fade" style="--d:0.25s">{L("≈ 9 seconden tv kijken", "≈ 9 seconds of watching TV")}</text><text x="80" y="230" font-family="JetBrains Mono, monospace" font-size="52" fill="#EEF2EA" class="fade" style="--d:0.30s">{L("0,26 ml", "0.26 ml")}</text><text x="80" y="258" font-family="JetBrains Mono, monospace" font-size="15" fill="#9DB2A4" text-anchor="start" class="fade" style="--d:0.35s">{L("≈ 5 druppels water", "≈ 5 drops of water")}</text><circle cx="392" cy="214" r="5" fill="#C6F36B" class="pop" style="--d:0.90s"></circle><circle cx="410" cy="214" r="5" fill="#C6F36B" class="pop" style="--d:0.96s"></circle><circle cx="428" cy="214" r="5" fill="#C6F36B" class="pop" style="--d:1.02s"></circle><circle cx="446" cy="214" r="5" fill="#C6F36B" class="pop" style="--d:1.08s"></circle><circle cx="464" cy="214" r="5" fill="#C6F36B" class="pop" style="--d:1.14s"></circle><line x1="600" y1="360" x2="1060" y2="360" stroke="#9DB2A4" pathLength="1" class="draw" style="--d:0.00s"></line><text x="600" y="30" font-family="JetBrains Mono, monospace" font-size="14" fill="#9DB2A4" text-anchor="start" class="fade" style="--d:0.40s">{L("alle datacenters ter wereld, TWh per jaar", "all data centres worldwide, TWh per year")}</text><rect x="660" y="239.65" width="120" height="120.35" fill="#24402F" class="growy" style="--d:0.50s"></rect><text x="720" y="227.65" font-family="JetBrains Mono, monospace" font-size="18" fill="#EEF2EA" text-anchor="middle" class="fade" style="--d:0.45s">415</text><text x="720" y="386" font-family="JetBrains Mono, monospace" font-size="14" fill="#9DB2A4" text-anchor="middle" class="fade" style="--d:0.50s">2024</text><rect x="860" y="85.95000000000005" width="120" height="274.04999999999995" fill="#C6F36B" class="growy" style="--d:0.70s"></rect><text x="920" y="73.95000000000005" font-family="JetBrains Mono, monospace" font-size="18" fill="#EEF2EA" text-anchor="middle" class="fade" style="--d:0.55s">945</text><text x="920" y="386" font-family="JetBrains Mono, monospace" font-size="14" fill="#9DB2A4" text-anchor="middle" class="fade" style="--d:0.60s">2030*</text><text x="1060" y="410" font-family="JetBrains Mono, monospace" font-size="12" fill="#9DB2A4" text-anchor="end" class="fade" style="--d:0.65s">{L("* verwachting IEA", "* IEA projection")}</text><g class="write" style="--d:2.00s"><text x="80" y="330" font-family="Kalam, Caveat, cursive" font-size="30" fill="#C6F36B" text-anchor="start" transform="rotate(-2 80 330)">{L("klein per vraag,", "small per prompt,")}</text></g><g class="write" style="--d:2.40s"><text x="80" y="370" font-family="Kalam, Caveat, cursive" font-size="30" fill="#C6F36B" text-anchor="start" transform="rotate(-2 80 370)">{L("groot bij elkaar", "big in total")}</text></g><path d="M 330 345 Q 450 330 560 300" fill="none" stroke="#C6F36B" stroke-width="2.4" stroke-linecap="round" pathLength="1" class="drawm" style="--d:1.70s"></path><path d="M 549.4 309.2 L 560 300 L 546.2 297.4" fill="none" stroke="#C6F36B" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" pathLength="1" class="drawm" style="--d:2.05s"></path><g class="write" style="--d:2.80s"><text x="630" y="170" font-family="Kalam, Caveat, cursive" font-size="26" fill="#C6F36B" text-anchor="start" transform="rotate(-3 630 170)">{L("≈ heel Japan nu →", "≈ Japan today →")}</text></g></svg>

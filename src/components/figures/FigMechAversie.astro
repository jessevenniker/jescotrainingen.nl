---
// Figuur voor de homepage. Aantekeningen in currentColor: de kleur komt van --marker.
import type { Lang } from '../../i18n';
interface Props { lang?: Lang }
const { lang = 'nl' } = Astro.props;
const L = (nl: string, en: string) => (lang === 'en' ? en : nl);
---
<svg viewBox="0 0 320 200" width="100%" role="img" aria-label={L("Schematische figuur", "Schematic figure")}><line x1="30" y1="170" x2="310" y2="170" stroke="#15201A" pathLength="1" class="draw" style="--d:0.00s"></line><line x1="30" y1="15" x2="30" y2="170" stroke="#15201A" pathLength="1" class="draw" style="--d:0.04s"></line><path d="M30 50 L150 50 L170 70 L310 72" fill="none" stroke="#2F6B4A" stroke-width="2" pathLength="1" class="draw" style="--d:0.30s"></path><path d="M30 46 L150 46 L170 140 L310 138" fill="none" stroke="#183126" stroke-width="2.5" pathLength="1" class="draw" style="--d:0.42s"></path><text x="236" y="64" font-family="Instrument Sans, sans-serif" font-size="12" fill="#2F6B4A" text-anchor="start" class="fade" style="--d:0.15s">{L("mens", "human")}</text><text x="236" y="132" font-family="Instrument Sans, sans-serif" font-size="12" fill="#183126" text-anchor="start" class="fade" style="--d:0.20s">{L("algoritme", "algorithm")}</text><line x1="160" y1="20" x2="160" y2="170" stroke="#D8DCD3" stroke-dasharray="3 3" pathLength="1" class="draw" style="--d:0.08s"></line><text x="160" y="188" font-family="Instrument Sans, sans-serif" font-size="12" fill="#5A665F" text-anchor="middle" class="fade" style="--d:0.25s">{L("één fout", "one mistake")}</text><g class="write" style="--d:2.00s"><text x="178" y="108" font-family="Kalam, Caveat, cursive" font-size="24" fill="currentColor" text-anchor="start" transform="rotate(-6 178 108)">{L("weg!", "gone!")}</text></g></svg>

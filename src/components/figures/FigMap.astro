---
// Figuur voor de homepage. Aantekeningen in currentColor: de kleur komt van --marker.
import type { Lang } from '../../i18n';
interface Props { lang?: Lang }
const { lang = 'nl' } = Astro.props;
const L = (nl: string, en: string) => (lang === 'en' ? en : nl);
---
<svg viewBox="0 0 1100 460" width="100%" role="img" aria-label={L("Figuur: kaart van gebruik tegen afspraken met hoogtelijnen rond bewust gebruik.", "Figure: map of use against agreements, with contour lines around deliberate use.")}><defs><clipPath id="mapc"><rect x="81" y="30" width="989" height="389"></rect></clipPath></defs><g clip-path="url(#mapc)"><ellipse cx="900" cy="110" rx="81.0" ry="49.199999999999996" fill="none" stroke="#C6F36B" stroke-width="1.6" transform="rotate(-12 900 110)" pathLength="1" class="draw" style="--d:0.20s"></ellipse><ellipse cx="900" cy="110" rx="148.5" ry="90.19999999999999" fill="none" stroke="#2E5442" stroke-width="1" transform="rotate(-12 900 110)" pathLength="1" class="draw" style="--d:0.34s"></ellipse><ellipse cx="900" cy="110" rx="222.75000000000003" ry="135.29999999999998" fill="none" stroke="#2E5442" stroke-width="1" transform="rotate(-12 900 110)" pathLength="1" class="draw" style="--d:0.48s"></ellipse><ellipse cx="900" cy="110" rx="303.75" ry="184.5" fill="none" stroke="#2E5442" stroke-width="1" transform="rotate(-12 900 110)" pathLength="1" class="draw" style="--d:0.62s"></ellipse><ellipse cx="900" cy="110" rx="391.5" ry="237.79999999999998" fill="none" stroke="#2E5442" stroke-width="1" transform="rotate(-12 900 110)" pathLength="1" class="draw" style="--d:0.76s"></ellipse><ellipse cx="900" cy="110" rx="486.00000000000006" ry="295.2" fill="none" stroke="#2E5442" stroke-width="1" transform="rotate(-12 900 110)" pathLength="1" class="draw" style="--d:0.90s"></ellipse><ellipse cx="900" cy="110" rx="594.0" ry="360.79999999999995" fill="none" stroke="#2E5442" stroke-width="1" transform="rotate(-12 900 110)" pathLength="1" class="draw" style="--d:1.04s"></ellipse><ellipse cx="900" cy="110" rx="715.5" ry="434.59999999999997" fill="none" stroke="#2E5442" stroke-width="1" transform="rotate(-12 900 110)" pathLength="1" class="draw" style="--d:1.18s"></ellipse></g><line x1="80" y1="420" x2="1070" y2="420" stroke="#9DB2A4" pathLength="1" class="draw" style="--d:0.00s"></line><line x1="80" y1="30" x2="80" y2="420" stroke="#9DB2A4" pathLength="1" class="draw" style="--d:0.04s"></line><circle cx="900" cy="110" r="6" fill="#C6F36B" class="pop" style="--d:0.90s"></circle><text x="916" y="104" font-family="JetBrains Mono, monospace" font-size="14" fill="#EEF2EA" text-anchor="start" class="fade" style="--d:0.15s">{L("bewust gebruik", "deliberate use")}</text><text x="80" y="450" font-family="JetBrains Mono, monospace" font-size="13" fill="#9DB2A4" text-anchor="start" class="fade" style="--d:0.20s">{L("weinig gebruik", "little use")}</text><text x="1070" y="450" font-family="JetBrains Mono, monospace" font-size="13" fill="#9DB2A4" text-anchor="end" class="fade" style="--d:0.25s">{L("iedereen gebruikt het", "everyone uses it")}</text><text x="52" y="225" font-family="JetBrains Mono, monospace" font-size="13" fill="#9DB2A4" text-anchor="middle" transform="rotate(-90 52 225)" class="fade" style="--d:0.30s">{L("afspraken", "agreements")}</text><circle cx="430" cy="330" r="9" fill="#C6F36B" class="pop" style="--d:0.96s"></circle><g class="write" style="--d:2.00s"><text x="452" y="352" font-family="Kalam, Caveat, cursive" font-size="34" fill="#C6F36B" text-anchor="start" transform="rotate(-4 452 352)">{L("jullie?", "you?")}</text></g><path d="M 520 320 Q 640 230 780 160" fill="none" stroke="#C6F36B" stroke-width="2.5" stroke-linecap="round" pathLength="1" class="drawm" style="--d:1.70s"></path><path d="M 771.4 171.1 L 780 160 L 766.0 160.2" fill="none" stroke="#C6F36B" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" pathLength="1" class="drawm" style="--d:2.05s"></path><circle cx="900" cy="110" r="9" fill="none" stroke="#C6F36B" stroke-width="2" class="pulse" style="animation-delay:0.0s"></circle><circle cx="430" cy="330" r="9" fill="none" stroke="#C6F36B" stroke-width="2" class="pulse" style="animation-delay:0.8s"></circle></svg>

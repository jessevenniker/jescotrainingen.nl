---
// Figuur voor de homepage. Aantekeningen in currentColor: de kleur komt van --marker.
import type { Lang } from '../../i18n';
interface Props { lang?: Lang }
const { lang = 'nl' } = Astro.props;
const L = (nl: string, en: string) => (lang === 'en' ? en : nl);
---
<svg viewBox="0 0 1100 360" width="100%" role="img" aria-label={L("Figuur: effect van AI in drie studies. Schrijftaken 40 procent sneller, klantenservice 15 procent meer opgeloste vragen, ervaren programmeurs 19 procent langzamer terwijl ze dachten 20 procent sneller te zijn.", "Figure: the effect of AI in three studies. Writing tasks 40 percent faster, customer support 15 percent more issues resolved, experienced developers 19 percent slower while they thought they were 20 percent faster.")}><line x1="560" y1="30" x2="560" y2="300" stroke="#15201A" pathLength="1" class="draw" style="--d:0.00s"></line><text x="550" y="325" font-family="Instrument Sans, sans-serif" font-size="13" fill="#5A665F" text-anchor="end" class="fade" style="--d:0.15s">{L("langzamer", "slower")}</text><text x="570" y="325" font-family="Instrument Sans, sans-serif" font-size="13" fill="#5A665F" text-anchor="start" class="fade" style="--d:0.20s">{L("sneller of meer", "faster or more")}</text><text x="80" y="66" font-family="Instrument Sans, sans-serif" font-size="17" fill="#15201A" text-anchor="start" class="fade" style="--d:0.25s">{L("Schrijftaken", "Writing tasks")}</text><text x="80" y="88" font-family="Instrument Sans, sans-serif" font-size="13" fill="#5A665F" text-anchor="start" class="fade" style="--d:0.30s">Noy &amp; Zhang (2023)</text><rect x="560" y="50" width="280" height="26" fill="#183126" class="grow" style="--d:0.60s"></rect><text x="850" y="68" font-family="Instrument Sans, sans-serif" font-size="16" fill="#15201A" text-anchor="start" class="fade" style="--d:0.35s">+40%</text><text x="850" y="88" font-family="Instrument Sans, sans-serif" font-size="13" fill="#5A665F" text-anchor="start" class="fade" style="--d:0.40s">{L("sneller klaar, beter beoordeeld", "done faster, rated higher")}</text><text x="80" y="146" font-family="Instrument Sans, sans-serif" font-size="17" fill="#15201A" text-anchor="start" class="fade" style="--d:0.45s">{L("Klantenservice", "Customer support")}</text><text x="80" y="168" font-family="Instrument Sans, sans-serif" font-size="13" fill="#5A665F" text-anchor="start" class="fade" style="--d:0.50s">{L("Brynjolfsson e.a. (2025)", "Brynjolfsson et al. (2025)")}</text><rect x="560" y="130" width="105" height="26" fill="#183126" class="grow" style="--d:0.72s"></rect><text x="675" y="148" font-family="Instrument Sans, sans-serif" font-size="16" fill="#15201A" text-anchor="start" class="fade" style="--d:0.55s">+15%</text><text x="675" y="168" font-family="Instrument Sans, sans-serif" font-size="13" fill="#5A665F" text-anchor="start" class="fade" style="--d:0.60s">{L("meer opgeloste vragen per uur", "more issues resolved per hour")}</text><text x="80" y="226" font-family="Instrument Sans, sans-serif" font-size="17" fill="#15201A" text-anchor="start" class="fade" style="--d:0.65s">{L("Ervaren programmeurs", "Experienced developers")}</text><text x="80" y="248" font-family="Instrument Sans, sans-serif" font-size="13" fill="#5A665F" text-anchor="start" class="fade" style="--d:0.70s">{L("Becker e.a. (2025)", "Becker et al. (2025)")}</text><rect x="427" y="210" width="133" height="26" fill="#2F6B4A" class="grow" style="--d:0.84s"></rect><text x="417" y="228" font-family="Instrument Sans, sans-serif" font-size="16" fill="#15201A" text-anchor="end" class="fade" style="--d:0.75s">−19%</text><text x="417" y="248" font-family="Instrument Sans, sans-serif" font-size="13" fill="#5A665F" text-anchor="end" class="fade" style="--d:0.80s">{L("langzamer, gemeten", "slower, measured")}</text><rect x="560" y="210" width="140" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="6 5" class="fade" style="--d:0.46s"></rect><g class="write" style="--d:2.00s"><text x="716" y="232" font-family="Kalam, Caveat, cursive" font-size="28" fill="currentColor" text-anchor="start" transform="rotate(-3 716 232)">{L("dachten ze: 20% sneller!", "they thought: 20% faster!")}</text></g><g class="write" style="--d:2.40s"><text x="110" y="300" font-family="Kalam, Caveat, cursive" font-size="28" fill="currentColor" text-anchor="start" transform="rotate(-3 110 300)">{L("het hangt af van de taak", "it depends on the task")}</text></g></svg>
